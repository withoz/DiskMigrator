<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Claude 데스크톱 앱 ↔ 떠 있는 DiskMigrator-X 사이의 중계기.

    ⚠ 왜 앱과 <b>별개의 실행 파일</b>인가.
    앱(DiskMigratorX.exe)의 매니페스트는 requireAdministrator입니다. 관리자 권한을 요구하는
    실행 파일은 표준입출력을 이어 받은 채로 켤 수 없습니다 — 권한 상승은 ShellExecute 경로로
    가고, 그 경로는 부모가 만든 파이프를 물려주지 못합니다(CreateProcess는 아예
    ERROR_ELEVATION_REQUIRED로 실패합니다). Claude 데스크톱은 표준입출력으로 서버를 켜므로,
    앱 자체를 등록하면 반드시 실패합니다.

    그래서 권한을 올리지 않는(asInvoker — 콘솔 앱의 기본값) 작은 실행 파일을 따로 둡니다.
    이 프로세스는 디스크를 만지지 않습니다. 오직 앱의 로컬 통로로 말을 넘길 뿐이라
    관리자 권한이 필요 없습니다.
  -->

  <PropertyGroup>
    <!--
      WinExe입니다 — Exe로 두면 Claude가 켤 때 검은 콘솔 창이 한 번 번쩍입니다.
      창이 없어도 부모가 넘겨준 표준입출력 핸들은 그대로 쓸 수 있습니다.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DiskMigrator.Bridge</RootNamespace>
    <AssemblyName>DiskMigratorX.Bridge</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Product>DiskMigrator-X</Product>
    <AssemblyTitle>DiskMigrator-X Claude bridge</AssemblyTitle>
    <Company>DiskMigrator</Company>
    <Description>Claude 데스크톱 앱과 DiskMigrator-X를 잇는 중계기</Description>
    <Copyright>Copyright © 2026 DiskMigrator</Copyright>

    <!-- 앱과 같은 번호로 갑니다 — 로그에서 짝이 맞는지 바로 보이게. -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      런타임이 없는 PC에서도 켜져야 합니다 — Claude가 이것을 직접 실행하기 때문입니다.
      앱과 달리 리플렉션으로 무언가를 찾아 쓰지 않으므로 트리밍해서 크기를 줄입니다.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- WPF를 끌고 들어오지 않게 — net8.0-windows는 기본적으로 켜지 않지만 명시합니다. -->
    <UseWPF>false</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <!--
    앱과 <b>같은 규칙으로</b> 토큰을 읽어야 합니다. 복사본을 두면 한쪽만 고쳐져 조용히
    어긋나므로, 원본 파일을 그대로 링크해 씁니다(어셈블리만 다를 뿐 같은 소스입니다).
  -->
  <ItemGroup>
    <Compile Include="..\DiskMigrator.App\AppIdentity.cs" Link="Shared\AppIdentity.cs" />
    <Compile Include="..\DiskMigrator.App\McpTokenStore.cs" Link="Shared\McpTokenStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- 시험이 표준입출력 자리에 자기 것을 끼워 넣고, 진짜 서버를 띄운 채로 이 경로를
       그대로 통과시켜 볼 수 있게 합니다. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DiskMigrator.Mcp.Tests" />
  </ItemGroup>

</Project>
