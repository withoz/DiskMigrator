<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        어두운 팔레트 — 밝은 쪽의 <b>따뜻한 회색</b>을 그대로 어둠으로 옮겼습니다.
        순검정(#000)과 순회색을 피한 이유: 이 앱의 밝은 화면이 따뜻한 모래빛이라,
        차가운 회색으로 뒤집으면 같은 앱으로 안 보입니다.

        <b>밝은 쪽을 그대로 뒤집지 않은 것</b>이 둘 있습니다.
        ① <b>선명한 색은 밝혀야 합니다.</b> Danger #DC2626은 흰 바탕에서 또렷하지만 어두운
           바탕에서는 가라앉아 오히려 덜 위험해 보입니다. 경고가 약해 보이는 것은 이 도구에서
           그냥 못생긴 것보다 나쁩니다.
        ② <b>옅은 배경(…Soft)은 뒤집되 채도를 남깁니다.</b> 그냥 어둡게만 하면 위험·주의·성공
           상자가 전부 같은 검정 덩어리가 되어 성격 구분이 사라집니다.

        ⚠ 이름은 Light.xaml과 <b>정확히 같아야</b> 합니다 — 하나라도 빠지면 그 이름을 쓰는
          화면이 뜨는 순간 앱이 죽습니다. `ThemeParityTests`가 그것을 막습니다.
    -->

    <!-- 바탕과 글 -->
    <SolidColorBrush x:Key="Surface" Color="#22201D" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1A1917" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#3B3730" />
    <SolidColorBrush x:Key="TextBrush" Color="#E9E4DC" />
    <SolidColorBrush x:Key="Muted" Color="#A79E93" />
    <SolidColorBrush x:Key="MutedFaint" Color="#6E6862" />

    <SolidColorBrush x:Key="LogoInk" Color="#D5D0C8" />

    <!-- 성격을 가르는 색 — 어두운 바탕에서 또렷하도록 밝은 쪽보다 올렸습니다. -->
    <SolidColorBrush x:Key="Accent" Color="#7FA6C8" />
    <SolidColorBrush x:Key="Danger" Color="#F26B6B" />
    <SolidColorBrush x:Key="Info" Color="#6BA5FA" />
    <SolidColorBrush x:Key="Warning" Color="#D2A059" />
    <SolidColorBrush x:Key="Success" Color="#82B994" />

    <SolidColorBrush x:Key="SelectionSoft" Color="#25313B" />

    <SolidColorBrush x:Key="SuccessSoft" Color="#1F2E26" />
    <SolidColorBrush x:Key="SuccessInk" Color="#9CD1B0" />
    <SolidColorBrush x:Key="SuccessBorder" Color="#2F5144" />

    <SolidColorBrush x:Key="DangerSoft" Color="#331F1F" />
    <SolidColorBrush x:Key="DangerBorder" Color="#5E3232" />
    <SolidColorBrush x:Key="DangerInk" Color="#F0AFAF" />

    <SolidColorBrush x:Key="WarningSoft" Color="#332A1C" />

    <SolidColorBrush x:Key="NeutralSoft" Color="#302C27" />

    <!-- Claude 활동 목록의 종류 표 — 글자는 밝으므로 바탕을 어둡게 두되 색조는 남깁니다. -->
    <SolidColorBrush x:Key="ChipNeutral" Color="#3A3630" />
    <SolidColorBrush x:Key="ChipSuccess" Color="#24382C" />
    <SolidColorBrush x:Key="ChipWarning" Color="#3B3320" />

    <SolidColorBrush x:Key="IconCopy" Color="#8FB4D4" />
    <SolidColorBrush x:Key="IconImage" Color="#E0B473" />
    <SolidColorBrush x:Key="IconTrouble" Color="#C3AC80" />

    <SolidColorBrush x:Key="SeverityBlocker" Color="#F26B6B" />
    <SolidColorBrush x:Key="SeverityWarn" Color="#E09440" />
    <SolidColorBrush x:Key="SeverityInfo" Color="#9A9288" />

    <!-- 파티션 배치 막대 — 칸 색(EFI·데이터 등)은 종류를 뜻하므로 두 모드에서 같습니다.
         여기서는 테두리와 빈 공간만 바탕에 맞춥니다. 빈 공간이 밝은 모래빛 그대로면
         어두운 화면에서 그 칸만 등불처럼 튀어, 없는 것이 제일 눈에 띄게 됩니다. -->
    <SolidColorBrush x:Key="LayoutUnallocated" Color="#3A352E" />
    <SolidColorBrush x:Key="LayoutAccentLine" Color="#4A5A6B" />
    <SolidColorBrush x:Key="LayoutDangerLine" Color="#6B3B3B" />

    <SolidColorBrush x:Key="ScrollThumb" Color="#4A453E" />

</ResourceDictionary>
