<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        밝은 팔레트 — 채도를 낮추고 회색을 따뜻한 쪽으로 옮겨 화면 전체를 차분하게 두되,
        위험(Danger)과 정보(Info)만 선명하게 남겼습니다. 주변이 조용할수록 이 둘이 더 튑니다.

        Danger는 일부러 낮추지 않았습니다. 디스크를 통째로 지우는 도구라
        "대상 삭제"·"차단"은 망설임 없이 빨강이어야 합니다.

        ⚠ 여기 있는 이름은 Dark.xaml에도 <b>하나도 빠짐없이</b> 있어야 합니다. 하나라도 없으면
          어두운 모드에서 그 이름을 쓰는 화면이 뜨는 순간 앱이 죽습니다(XamlParseException).
          `ThemeParityTests`가 두 파일의 이름 목록을 맞대어 그것을 막습니다.
    -->

    <!-- 바탕과 글 -->
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#FAF8F5" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#E7E1D9" />
    <SolidColorBrush x:Key="TextBrush" Color="#33302B" />
    <SolidColorBrush x:Key="Muted" Color="#837B72" />

    <!-- 안 고른 갈래의 글자. Muted보다 옅어, 고른 쪽과 한눈에 갈립니다.
         이 색은 하위 갈래 버튼에만 씁니다 — 다른 곳까지 흐려지면 화면 전체가 바랩니다. -->
    <SolidColorBrush x:Key="MutedFaint" Color="#A8A8A8" />

    <!-- 로고 마크용 — TextBrush(#33302B)를 흰색 쪽으로 10% 밝힌 값. 너무 새까맣지 않게. -->
    <SolidColorBrush x:Key="LogoInk" Color="#474540" />

    <!-- 성격을 가르는 색 -->
    <SolidColorBrush x:Key="Accent" Color="#52738F" />
    <SolidColorBrush x:Key="Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="Info" Color="#2563EB" />
    <SolidColorBrush x:Key="Warning" Color="#B08541" />
    <SolidColorBrush x:Key="Success" Color="#6B9478" />

    <SolidColorBrush x:Key="SelectionSoft" Color="#EEF3F7" />

    <!-- 묶음 안에서 지금 고른 갈래를 표시하는 색.
         테두리와 글자만 바꾸면 배경이 둘 다 같아 어느 쪽이 켜졌는지 잘 안 보였습니다 —
         파랑(Accent)은 위 탭이 이미 쓰고 있어, 아래 줄은 초록 계열로 갈라 놓습니다. -->
    <SolidColorBrush x:Key="SuccessSoft" Color="#E7F1EA" />
    <SolidColorBrush x:Key="SuccessInk" Color="#3D6B51" />
    <SolidColorBrush x:Key="SuccessBorder" Color="#CDE8DB" />

    <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F2" />
    <SolidColorBrush x:Key="DangerBorder" Color="#FECACA" />
    <SolidColorBrush x:Key="DangerInk" Color="#991B1B" />

    <SolidColorBrush x:Key="WarningSoft" Color="#FFF7ED" />

    <!-- 진행 막대의 빈 부분처럼 성격이 없는 옅은 바탕 -->
    <SolidColorBrush x:Key="NeutralSoft" Color="#F3F4F6" />

    <!-- Claude 활동 목록의 종류 표 -->
    <SolidColorBrush x:Key="ChipNeutral" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ChipSuccess" Color="#DCFCE7" />
    <SolidColorBrush x:Key="ChipWarning" Color="#FEF3C7" />

    <!-- 세 갈래 탭의 그림 문자. 탭마다 성격이 다르다는 것을 색으로도 알립니다. -->
    <SolidColorBrush x:Key="IconCopy" Color="#7FA6C8" />
    <SolidColorBrush x:Key="IconImage" Color="#D9A65A" />
    <SolidColorBrush x:Key="IconTrouble" Color="#B39A6B" />

    <!-- 진단 항목의 심각도 (SeverityToBrushConverter가 이 이름으로 찾아 씁니다) -->
    <SolidColorBrush x:Key="SeverityBlocker" Color="#DC2626" />
    <SolidColorBrush x:Key="SeverityWarn" Color="#D97706" />
    <SolidColorBrush x:Key="SeverityInfo" Color="#6B7280" />

    <!-- 파티션 배치 막대 — 칸 색은 종류를 뜻하므로 두 모드에서 같고,
         테두리와 빈 공간만 바탕에 맞춰 바뀝니다. -->
    <SolidColorBrush x:Key="LayoutUnallocated" Color="#E4DED5" />
    <SolidColorBrush x:Key="LayoutAccentLine" Color="#C3CEDA" />
    <SolidColorBrush x:Key="LayoutDangerLine" Color="#FECACA" />

    <!-- 스크롤 막대의 손잡이. 바탕과 붙지 않을 만큼만 진하게. -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#CFC8BE" />

</ResourceDictionary>
