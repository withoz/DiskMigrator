<Window x:Class="DiskMigrator.App.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DiskMigrator 사용권 계약"
        Height="620" Width="660"
        MinHeight="500" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="사용권 계약 (EULA)"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,10" />

        <!-- 데이터 파괴 위험을 맨 위에 빨강으로 못 박습니다 — 이 도구의 핵심 위험입니다. -->
        <Border Grid.Row="1" Background="{StaticResource DangerSoft}"
                BorderBrush="{StaticResource Danger}" BorderThickness="1"
                CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Danger}" FontWeight="SemiBold"
                       Text="이 프로그램은 대상(쓰기) 디스크의 모든 데이터를 영구히 삭제할 수 있습니다. 계속하려면 아래 내용을 읽고 동의하십시오." />
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                <TextBlock x:Name="EulaText" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12.5" LineHeight="20" />
            </ScrollViewer>
        </Border>

        <CheckBox x:Name="AgreeCheck" Grid.Row="3" Margin="2,14,0,0"
                  Foreground="{StaticResource TextBrush}"
                  Content="위 내용을 읽고 이해했으며, 이에 동의합니다." />

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="동의하지 않음 (종료)" Click="Decline_Click"
                    Padding="14,7" Margin="0,0,10,0" />
            <Button x:Name="AcceptButton" Style="{StaticResource AccentButton}"
                    IsEnabled="{Binding IsChecked, ElementName=AgreeCheck}"
                    Click="Accept_Click" Padding="16,7">
                <TextBlock Text="동의하고 시작" Foreground="White" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
