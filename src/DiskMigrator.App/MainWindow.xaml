<Window x:Class="DiskMigrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DiskMigrator.App.ViewModels"
        xmlns:loc="clr-namespace:DiskMigrator.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{loc:Loc AppTitle}" Height="840" Width="1180"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI, Malgun Gothic">

    <!-- 윈도우에서 도움말은 늘 F1입니다. 배울 것이 없으니 어느 화면에서나 통하게 둡니다.
         설명서가 없으면 아무 일도 일어나지 않습니다(오류를 띄우지 않습니다). -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />
    </Window.InputBindings>

    <Window.Resources>

        <!--
            파티션 배치 막대 — 디스크가 실제로 어떻게 나뉘어 있고 어디가 비어 있는지 한눈에 봅니다.
            "더 작은 디스크로 옮길 수 있는가"는 결국 파티션이 차지한 끝의 문제이므로(맞춤 클론),
            뒤쪽 빈 공간을 눈으로 확인할 수 있게 하는 것이 핵심입니다.

            조각 폭은 부모 폭 × 비율로 계산합니다. WPF에는 데이터로 만들어지는 가변 개수 요소에
            "부모의 N%"를 주는 선언적 방법이 없어서 컨버터를 씁니다.
        -->
        <DataTemplate x:Key="DiskLayoutTemplate">
            <StackPanel Margin="0,10,0,0">

                <!--
                    막대 머리글 — 이 막대가 어느 디스크의 것이고 무슨 일이 일어나는지.
                    열 제목은 목록 맨 위에 있어 막대를 들여다보는 동안 시야에서 사라집니다.
                    원본과 대상을 뒤바꾸는 것이 이 도구에서 가장 위험한 실수라 여기서 한 번 더 말합니다.
                -->
                <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,5" Margin="0,0,0,7">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{Binding RoleBrush}" CornerRadius="3"
                            Padding="6,1" Margin="0,0,7,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RoleText}" Style="{StaticResource Micro}"
                                   FontWeight="SemiBold" Foreground="White" />
                    </Border>

                    <TextBlock DockPanel.Dock="Right" Text="{Binding ActionText}"
                               Style="{StaticResource Micro}" Foreground="{Binding ActionBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DiskName}" Style="{StaticResource Caption}"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DiskSizeText}" Style="{StaticResource Caption}"
                                   Margin="6,0,0,0" />
                    </StackPanel>
                </DockPanel>
                </Border>

                <Border BorderBrush="{Binding BarBorderBrush}" BorderThickness="1" CornerRadius="5"
                        Background="{StaticResource SurfaceAlt}" Padding="2" ClipToBounds="True">
                  <Grid x:Name="BarArea">
                    <ItemsControl ItemsSource="{Binding Segments}" ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="40" Margin="0,0,1,0" CornerRadius="2"
                                        Background="{Binding Fill}" ToolTip="{Binding Tooltip}">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource FractionToWidth}">
                                            <Binding Path="Fraction" />
                                            <Binding Path="ActualWidth"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                        </MultiBinding>
                                    </Border.Width>

                                    <Grid>
                                        <!--
                                            조각 위에 드라이브 문자를 직접 적습니다. 범례를 눈으로
                                            따라가지 않아도 어느 조각이 C: 인지 바로 알 수 있습니다.
                                            좁은 조각에는 넣지 않습니다 — 잘리면 오히려 지저분합니다.
                                        -->
                                        <TextBlock Text="{Binding BarLabel}" Style="{StaticResource Micro}"
                                                   FontWeight="SemiBold" Foreground="{Binding BarLabelBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                                   Margin="2,4,2,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding ShowBarLabel,
                                                                Converter={StaticResource BoolToVisibility}}" />

                                        <!-- 사용 중인 만큼을 아래쪽에 짙은 띠로 겹쳐 그립니다. -->
                                        <Border VerticalAlignment="Bottom" Height="6" Margin="3,0,3,3"
                                                CornerRadius="1" Background="#33000000"
                                                Visibility="{Binding HasUsage,
                                                             Converter={StaticResource BoolToVisibility}}"
                                                HorizontalAlignment="Stretch" />
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                Height="6" Margin="3,0,3,3" CornerRadius="1" Background="#B3FFFFFF"
                                                Visibility="{Binding HasUsage,
                                                             Converter={StaticResource BoolToVisibility}}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                                    <Binding Path="UsedFraction" />
                                                    <Binding Path="ActualWidth"
                                                             RelativeSource="{RelativeSource AncestorType=Border}" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        최소 크기(현재 파티션) 한계선 — 이 왼쪽으로는 줄일 수 없습니다.
                        빨간 점선으로 "여기까지가 데이터 용량"임을 표시합니다. 손잡이와 같은
                        조건(변경 후 막대 · 조정 가능)에서만 보이고, 클릭은 통과시킵니다.
                    -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Top" IsHitTestVisible="False">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                <Binding Path="IsTargetAfter" />
                                <Binding Path="DataContext.ShowResizeHandle"
                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                        </StackPanel.Visibility>
                        <Border IsHitTestVisible="False">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="DataContext.ResizeMinFraction"
                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="ActualWidth" ElementName="BarArea" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                        <Line X1="0" Y1="0" X2="0" Y2="40" Stroke="{StaticResource Danger}"
                              StrokeThickness="1.5" StrokeDashArray="2,2" />
                    </StackPanel>

                    <!--
                        끌어서 조정하는 손잡이 — '변경 후' 막대에서만, 그리고 지금 조정할 수 있을
                        때만 나옵니다. 왼쪽 여백을 비율×막대너비로 밀어 경계 위에 세웁니다.
                        조각과 같은 계산(FractionToWidth)을 쓰므로 정확히 경계에 붙습니다.
                    -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <StackPanel.Visibility>
                            <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                                <Binding Path="IsTargetAfter" />
                                <Binding Path="DataContext.ShowResizeHandle"
                                         RelativeSource="{RelativeSource AncestorType=Window}" />
                            </MultiBinding>
                        </StackPanel.Visibility>

                        <!-- 경계까지 밀어 주는 빈 칸. 조각과 같은 계산이라 정확히 붙습니다. -->
                        <Border IsHitTestVisible="False">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource FractionToWidth}">
                                    <Binding Path="DataContext.ResizeHandleFraction"
                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <Binding Path="ActualWidth" ElementName="BarArea" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>

                        <Thumb x:Name="ResizeThumb" Width="26" Margin="-13,0,0,0"
                               Cursor="SizeWE" Focusable="True"
                               DragDelta="ResizeThumb_DragDelta"
                               KeyDown="ResizeThumb_KeyDown"
                               ToolTip="{loc:Loc ResizeHandleTooltip}">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <!--
                                        잡을 곳은 넓게(26px 투명), 가운데 가는 빨간 경계 안내선 + 중앙에
                                        흰 좌우 삼각형(◀▶)만. 예전엔 가는 선만 있어 "움직이는 막대"인지
                                        구별이 안 됐습니다 — 삼각형으로 '양쪽으로 끌 수 있음'을 분명히 합니다.
                                    -->
                                    <Grid Background="Transparent">
                                        <!-- 경계 안내선 -->
                                        <Border Width="3" Background="{StaticResource Danger}"
                                                HorizontalAlignment="Center" />
                                        <!-- 중앙에 흰 좌우 삼각형(◀▶)만 — 배경 대비를 위해 옅은 그림자 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="3"
                                                                  ShadowDepth="0" Opacity="0.6" />
                                            </StackPanel.Effect>
                                            <Path Data="M 7,0 L 0,6 L 7,12 Z" Fill="White" Margin="0,0,5,0" />
                                            <Path Data="M 0,0 L 7,6 L 0,12 Z" Fill="White" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </StackPanel>
                  </Grid>
                </Border>

                <!--
                    범례: 조각이 좁아 글자를 못 넣으므로 아래에 목록으로 풉니다.

                    WrapPanel은 항목 글자 길이에 따라 한 줄에 2개가 되기도 3개가 되기도 해서
                    막대마다 줄바꿈 위치가 달라졌습니다. 항상 2칸 격자로 고정하고, 이름 칸 폭을
                    SharedSizeGroup으로 묶어 색칩·이름·수치의 세로선이 모든 줄에서 맞게 합니다.
                -->
                <ItemsControl ItemsSource="{Binding Segments}" Margin="0,7,0,0"
                              Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,16,4" ToolTip="{Binding Tooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LegendName" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 색칩 모서리는 막대 조각과 같은 반경이어야 같은 것으로 읽힙니다. -->
                                <Border Grid.Column="0" Width="9" Height="9" CornerRadius="2"
                                        Background="{Binding Fill}"
                                        VerticalAlignment="Center" Margin="0,0,6,0" />

                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Style="{StaticResource Micro}"
                                           FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />

                                <TextBlock Grid.Column="2" Text="{Binding DetailText}"
                                           VerticalAlignment="Center" Style="{StaticResource Micro}"
                                           Foreground="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Micro}" Margin="0,2,0,0"
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" />

                <TextBlock Text="{Binding TrailingFreeText}" Style="{StaticResource Micro}" Margin="0,2,0,0"
                           Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                           Visibility="{Binding TrailingFreeText,
                                        Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- 시작 화면 상단의 모드 전환 탭. 각 탭이 독립된 테두리 카드이며, 활성 탭만 강조색 배경. -->
        <Style x:Key="ModeTab" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,9" />
            <!-- 각 탭이 그리드 셀을 꽉 채워야 탭 줄 양 끝이 아래 패널(760px)과 정확히 맞습니다. -->
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            부팅 복구 버튼 한 벌 — <b>두 화면이 같은 것을 쓰게</b> 합니다.

            ⚠ 예전에는 이 덩어리가 XAML에 두 번 복사돼 있었습니다(부팅 복구 화면 · 완료 화면).
              한쪽만 고치면 두 화면이 조용히 갈립니다 — 이 프로젝트에서 이미 겪은 종류의
              사고입니다(같은 결함을 브랜치 양쪽에서 고치다 한쪽을 빠뜨렸던 일).
              여기 한 곳에 두고 양쪽이 참조합니다.

            버튼은 하나뿐입니다. 예전의 '그래도 복구 해보기'는 같은 명령을 부르는 두 번째
            버튼이었고 서로 배타적이라 절대 함께 뜨지 않았습니다 — 설명만 상황에 따라
            바뀌면 되는 것을 버튼·상자·안내문으로 늘려 놓았던 셈입니다.
        -->
        <DataTemplate x:Key="BootRepairActionTemplate">
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding ShowRepairBoot, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{loc:Loc RepairBootBtn}" Command="{Binding RepairBootCommand}"
                            MinWidth="120" Padding="14,7" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Micro}"
                               TextWrapping="Wrap" MaxWidth="420" Text="{Binding RepairBootHint}" />
                </StackPanel>
                <TextBlock Text="{loc:Loc Repairing}" Margin="0,6,0,0" Style="{StaticResource Caption}"
                           Visibility="{Binding IsRepairingBoot, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding BootRepairMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding BootRepairRan, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BootRepairSuccess}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

    </Window.Resources>

    <!-- RootLayout: 작은 화면(부팅 USB의 WinPE 등)에서는 코드비하인드가 LayoutTransform으로
         전체 UI를 비율 축소해, 스크롤·잘림 없이 화면 안에 다 들어가게 합니다. -->
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 오른쪽 칸은 Claude 대화 패널 자리입니다. 닫혀 있을 때는 폭 0이라 화면이
             지금까지와 똑같습니다. 아래쪽에 붙이는 방법도 생각했지만, 대화가 길어지면
             그 높이로는 안 보입니다 — 창 높이를 다 쓰는 옆이 맞습니다. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ===== 헤더 + 업데이트 배너 ===== -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1" Padding="40,13">
            <Grid>
                <!--
                    로고 락업 — DM 마크 + 세로 선 + DISKMIGRATOR 워드마크.
                    마크는 세 번째 변형(볼에서 M이 뻗어 나옴)을 벡터로 그립니다. 헤더 배경이
                    밝으므로 마크·글자 모두 먹색(TextBrush)입니다. 배경이 어두우면 흰 로고를 쓰기로
                    했으므로 배지 없이 글자색을 따라가게 둡니다. 별도 이미지 없이 어떤 DPI에서도 선명.
                    (WPF에는 letter-spacing이 없어 얇은 공백 U+2009로 자간을 줍니다.)
                -->
                <StackPanel Orientation="Horizontal">
                    <!--
                        DM 마크 (docs/brand/app-icon.svg와 같은 확정 형태). D는 채움(카운터 뚫림),
                        M은 각진 획(오른쪽 위 꼭지는 miterlimit 2.2로 평평하게 잘림). 헤더는 밝은
                        바탕이라 LogoInk 색을 씁니다. Canvas(256x165)에 마크의 viewBox(56,95)를
                        (-56,-95) 밀어 담습니다 — mark.svg의 viewBox와 같은 틀입니다.
                    -->
                    <Viewbox Height="45" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Canvas Width="256" Height="165">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="-56" Y="-95" />
                            </Canvas.RenderTransform>
                            <Path Fill="{StaticResource LogoInk}"
                                  Data="F0 M 95.984375,107.03125 h 50.031255 c 42.9432,0 69.21758,31.95561 69.17612,61.12102 -0.0446,31.36872 -17.96704,62.86336 -69.17612,62.86336 H 95.984375 c -13.254834,0 -24,-10.74517 -24,-24 v -75.98438 c 0,-13.25483 10.745166,-24 24,-24 z m 14.000005,32.67188 h 36.03125 c 28,0 37.68751,16.98437 37.68751,29.98437 0,13 -9.68751,28.65626 -37.68751,28.65626 h -36.03125 z" />
                            <!--
                                M은 "획"이 아니라 채운 도형(외곽선)으로 넣습니다. WPF와 Inkscape가
                                획의 miter/bevel을 다르게 렌더링해 앱 헤더와 아이콘의 꼭지 모양이
                                달라졌기 때문입니다. Inkscape가 획(굵기36·miterlimit2.2·둥근끝)을
                                외곽선으로 변환한 결과를 그대로 넣어, 어디서든 아이콘과 똑같이 보입니다.
                            -->
                            <Path Fill="{StaticResource LogoInk}"
                                  Data="F1 M 268.87891,110.23633 217.88672,189.20117 196.9375,131.86914 A 18,18 0 0 0 173.85352,121.14063 18,18 0 0 0 163.125,144.22461 l 33.35937,91.29687 32.02735,3.58594 35.17773,-54.47656 -1.66211,46.72851 a 18,18 0 0 0 17.34766,18.62891 18,18 0 0 0 18.62891,-17.34766 l 3.98437,-111.99999 z" />
                        </Canvas>
                    </Viewbox>

                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1,0,0,0"
                            Padding="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel>
                            <!-- 워드마크 뒤의 -X는 수동 버전과 한눈에 구분되어야 하므로 강조합니다.
                                 두 앱이 같은 PC에 함께 설치되며, 어느 창을 보고 있는지 모르면
                                 "Claude 연결이 안 보인다" 같은 혼란이 생깁니다. -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="D&#x2009;I&#x2009;S&#x2009;K&#x2009;M&#x2009;I&#x2009;G&#x2009;R&#x2009;A&#x2009;T&#x2009;O&#x2009;R"
                                           FontSize="16.5" FontWeight="Normal" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="-X" FontSize="16.5" FontWeight="Bold" Margin="3,0,0,0"
                                           Foreground="{StaticResource Accent}" />
                            </StackPanel>
                            <!-- 제작사 링크 — 클릭하면 기본 브라우저로 엽니다(무료 도구의 유일한 보상 창구).
                                 스플래시·설명서와 같은 두 사이트 표기, 각각 따로 클릭됩니다. -->
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0">
                                <StackPanel.Resources>
                                    <Style x:Key="SiteLink" TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="10.5" />
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                <Setter Property="TextDecorations" Value="Underline" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Resources>
                                <!-- 실행 중인 버전 — 스플래시는 곧 사라지므로 여기서 항상 확인할 수 있게
                                     둡니다. 어셈블리에서 읽어 표시하므로 버전을 올리면 자동으로 따라옵니다. -->
                                <TextBlock Text="{x:Static vm:MainViewModel.AppVersion}"
                                           FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,4,0" />
                                <TextBlock Text="by " FontSize="10.5" Foreground="{StaticResource Muted}" />
                                <!-- AixxiA.kr는 준비 중 — 사이트가 열리면 SiteLink 스타일+Tag로 활성화 -->
                                <TextBlock Text="AixxiA.kr" FontSize="10.5" Foreground="{StaticResource Muted}" />
                                <TextBlock Text=" / " FontSize="10.5" Foreground="{StaticResource Muted}" />
                                <TextBlock Text="AiDesign.co.kr" Style="{StaticResource SiteLink}"
                                           Tag="http://aidesign.co.kr" MouseLeftButtonUp="CompanyLink_Click" />

                                <!-- Claude에 들어와 있는 계정. 오른쪽 머리말에 있던 것을 여기로
                                     옮깁니다 — 그쪽은 누르는 것들(묻기·언어)이 모이는 자리이고,
                                     이것은 눌러도 아무 일이 없는 '지금 상태'라서요. -->
                                <TextBlock Text=" · " FontSize="10.5" Foreground="{StaticResource Muted}"
                                           Visibility="{Binding ShowClaudeAccount, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding ClaudeAccountText}" FontSize="10.5"
                                           Foreground="{StaticResource Muted}"
                                           Visibility="{Binding ShowClaudeAccount, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- 누가 들어와 있는지. 로그인돼 있으면 계정과 구독 종류를, 아니면 [로그인]을,
                         Claude Code가 아예 없으면 [설치하기]를 보여 줍니다.
                         부팅 USB(WinPE)에서는 셋 다 나오지 않습니다 — 거기서는 설치할 수 없고,
                         쓸 수 없는 버튼은 도움이 아니라 방해입니다. -->
                    <!-- 막혔을 때 누르는 자리 — 어느 화면에 있든 여기 있습니다.
                         Claude Code가 있고 로그인까지 돼 있을 때만 나옵니다. 쓸 수 없는 버튼을
                         보여 주는 것은 도움이 아니라 방해입니다. -->
                    <Button Command="{Binding ToggleChatCommand}" Content="{loc:Loc ChatOpenBtn}"
                            Cursor="Hand" Margin="0,0,14,0" VerticalAlignment="Center" Padding="12,5"
                            FontSize="12" Style="{StaticResource AccentButton}"
                            Visibility="{Binding CanAskClaude, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 계정 표시는 로고 아래 줄로 옮겼습니다(AiDesign.co.kr 옆). -->

                    <Button Command="{Binding ClaudeLoginCommand}" Content="{loc:Loc ClaudeLoginBtn}"
                            Cursor="Hand" Margin="0,0,14,0" VerticalAlignment="Center" Padding="10,4"
                            FontSize="12"
                            Visibility="{Binding ShowClaudeLogin, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{loc:Loc ClaudeNotInstalled}" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,14,0" Foreground="{StaticResource Muted}"
                               Visibility="{Binding ShowClaudeInstall, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Claude 연결 — 작업 모드가 아니라 설정에 가까우므로 모드 탭에 넣지 않고 헤더에 둡니다.
                         점 색으로 통로가 열려 있는지 한눈에 보입니다. -->
                    <Button Command="{Binding SetModeCommand}" CommandParameter="Assistant"
                            Cursor="Hand" Margin="0,0,16,0" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BorderBrushSoft}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding McpRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{loc:Loc ModeAssistant}" FontSize="12.5" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAssistantMode}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- 화면 색조: ☀ · ☾. 언어 토글과 <b>같은 모양</b>으로 두어 같은 종류의 설정임을
                         알립니다. 글자를 더하지 않으려고 이름 없이 그림 문자만 씁니다.
                         고른 적이 없으면 Windows 설정을 따르므로 대부분은 이것을 건드릴 일이 없습니다.
                         전환=창 재생성이라 언어와 같은 조건으로 작업 중에는 비활성화합니다. -->
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanSwitchLanguage}"
                                Margin="0,0,14,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- ⚠ Background="Transparent"와 Padding이 <b>둘 다</b> 있어야 합니다.
                             글자만 한 그림 문자는 과녁이 13px밖에 안 되고, 배경이 없는 TextBlock은
                             글자 획 위에서만 눌립니다 — 실기에서 눌러도 아무 일이 없었습니다.
                             "한국어·English"는 글자가 넓어 그 문제가 드러나지 않았습니다. -->
                        <TextBlock x:Name="ThemeLight" Text="☀" Cursor="Hand" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol" FontSize="14"
                                   Background="Transparent" Padding="6,4"
                                   ToolTip="{loc:Loc ThemeLightTip}" MouseLeftButtonUp="ThemeLight_Click" />
                        <TextBlock Text="·" FontSize="12.5" Margin="2,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource BorderBrushSoft}" />
                        <TextBlock x:Name="ThemeDark" Text="☾" Cursor="Hand" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Symbol" FontSize="14"
                                   Background="Transparent" Padding="6,4"
                                   ToolTip="{loc:Loc ThemeDarkTip}" MouseLeftButtonUp="ThemeDark_Click" />
                    </StackPanel>

                    <!-- 도움말 — 이 앱은 안내를 화면에 늘어놓지 않고 설명서로 보냅니다.
                         그러면 설명서로 가는 길이 화면에 있어야 그 약속이 온전해집니다.
                         설명서가 앱 옆에 없으면(개발용 빌드 등) 아예 보이지 않습니다 —
                         눌러도 아무 일이 없는 글자는 앱이 고장 난 것처럼 보이게 합니다. -->
                    <TextBlock Text="{loc:Loc HelpLink}" Cursor="Hand" VerticalAlignment="Center"
                               FontSize="12.5" Background="Transparent" Padding="6,4" Margin="0,0,10,0"
                               Foreground="{StaticResource Muted}"
                               Visibility="{Binding HasHelp, Converter={StaticResource BoolToVisibility}}"
                               MouseLeftButtonUp="Help_Click" />

                    <!-- 언어 전환: 한국어 · English. 고른 언어는 저장되고 창이 즉시 새 언어로 다시 그려집니다.
                         전환=창 재생성이므로 작업 중(클론·백업·복원·부팅 USB)에는 비활성화합니다 —
                         진행 화면이 사라지고 작업이 화면 없이 남는 사고를 막습니다. -->
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanSwitchLanguage}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock x:Name="LangKo" Text="한국어" Cursor="Hand" VerticalAlignment="Center"
                                   FontSize="12.5" MouseLeftButtonUp="LangKo_Click" />
                        <TextBlock Text="·" FontSize="12.5" Margin="7,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource BorderBrushSoft}" />
                        <TextBlock x:Name="LangEn" Text="English" Cursor="Hand" VerticalAlignment="Center"
                                   FontSize="12.5" MouseLeftButtonUp="LangEn_Click" />
                    </StackPanel>

                    <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                            CornerRadius="6" Padding="10,5" Margin="14,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{loc:Loc NotAdminBadge}"
                                   Style="{StaticResource Caption}" Foreground="{StaticResource Danger}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Claude의 제안 카드 — 계획서 §6.3의 1차 관문.
             모달이 아닙니다. 강제로 답을 요구하면 내용을 읽지 않고 누르게 됩니다.
             [적용]을 눌러야 비로소 선택이 채워지고, 그 뒤에도 모델명 입력이 남습니다. -->
        <Border Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource Warning}"
                BorderThickness="0,0,0,1" Padding="40,10"
                Visibility="{Binding HasProposal, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ApplyProposalCommand}" Style="{StaticResource AccentButton}"
                            Padding="16,6" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc ProposalApply}" Foreground="White" />
                    </Button>
                    <Button Command="{Binding DismissProposalCommand}" Padding="14,6">
                        <TextBlock Text="{loc:Loc ProposalDismiss}" />
                    </Button>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc ProposalTitle}" Foreground="{StaticResource Warning}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />

                        <!-- 무엇을 하자는 제안인지. 복원·복제는 대상이 지워지므로 색을 달리합니다. -->
                        <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" FontWeight="SemiBold" FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Loc ProposalKindClone}" />
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Proposal.Kind}" Value="Backup">
                                            <Setter Property="Text" Value="{loc:Loc ProposalKindBackup}" />
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Proposal.Kind}" Value="Restore">
                                            <Setter Property="Text" Value="{loc:Loc ProposalKindRestore}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Proposal.Kind}" Value="BootRepair">
                                            <Setter Property="Text" Value="{loc:Loc ProposalKindBootRepair}" />
                                            <Setter Property="Foreground" Value="{StaticResource Muted}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding Proposal.Endpoints}"
                                   Foreground="{StaticResource Muted}" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <!-- Claude가 왜 제안했는지 — 사용자가 판단할 근거입니다. -->
                    <TextBlock Text="{Binding Proposal.Reason}" TextWrapping="Wrap"
                               FontSize="12.5" Margin="0,3,0,0" />

                    <!-- 적용해도 실행되지 않는다는 사실을 분명히 밝힙니다. 모델명 입력이
                         필요한 경우와 아닌 경우의 문구가 다릅니다. -->
                    <TextBlock TextWrapping="Wrap" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Text" Value="{loc:Loc ProposalPlainNote}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Proposal.NeedsTypedConfirmation}" Value="True">
                                        <Setter Property="Text" Value="{loc:Loc ProposalConfirmNote}" />
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 업데이트 알림 배너 — 새 버전이 있을 때만 보입니다. 자동으로 내려받지 않고
             릴리스 페이지 링크만 엽니다(다운로드·설치는 사용자가 결정). -->
        <Border Background="{StaticResource SelectionSoft}" BorderBrush="{StaticResource Info}"
                BorderThickness="0,0,0,1" Padding="40,8"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenUpdatePageCommand}" Style="{StaticResource AccentButton}"
                            Padding="14,5" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc UpdateDownload}" Foreground="White" />
                    </Button>
                    <Button Command="{Binding DismissUpdateCommand}" Padding="12,5">
                        <TextBlock Text="{loc:Loc UpdateLater}" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc UpdateAvailable}" Foreground="{StaticResource Info}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding UpdateVersionText}" Foreground="{StaticResource Info}"
                               FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>
        </StackPanel>

        <!-- ===== 1단계: 선택 =====
             내용이 창 높이를 넘으면 스크롤합니다. 예전에는 남는 높이를 목록이 가져가는
             구조였는데, 옵션·막대·안전 문구가 늘어나면서 목록 몫이 0이 되어 아예 사라졌습니다.
             목록에 최소 높이를 보장하고 넘치는 만큼만 스크롤하는 편이 안전합니다. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Selecting}">
        <StackPanel Margin="40,14,40,16">

            <!-- ===== 모드 선택: 묶음 셋 =====
                 갈림길이 다섯이면 무엇을 눌러야 할지 아는 사람에게만 빠릅니다. 디스크가 안 켜져
                 찾아온 사람에게 그건 이미 어려운 질문입니다.

                 없애지 않고 묶습니다 — 백업과 복원은 같은 파일을 두고 하는 반대 동작이고,
                 부팅 복구와 부팅 USB는 둘 다 안 켜질 때 쓰는 것입니다. 갈래가 둘인 묶음에서만
                 아래 줄이 나옵니다.
                 Width는 고정이어야 합니다 — MaxWidth+Center는 내용 크기로 줄어들어 별(*) 열이 안 펼쳐집니다. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding SetModeCommand}" CommandParameter="Clone">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💽" FontFamily="Segoe UI Emoji" FontSize="16" Foreground="{StaticResource IconCopy}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{loc:Loc GroupCopy}" />
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroupCopy}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Accent}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2" Command="{Binding SetModeCommand}" CommandParameter="Backup">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="16" Foreground="{StaticResource IconImage}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{loc:Loc GroupImage}" />
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroupImage}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Accent}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="4" Command="{Binding SetModeCommand}" CommandParameter="FixBoot">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛠️" FontFamily="Segoe UI Emoji" FontSize="16" Foreground="{StaticResource IconTrouble}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{loc:Loc GroupTrouble}" />
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModeTab}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsGroupTrouble}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Accent}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 묶음 안의 갈래. 하나뿐인 묶음(디스크 복사)에서는 나오지 않습니다 —
                 고를 것이 하나면 고르라고 하지 않습니다. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12"
                        Visibility="{Binding ShowSubModes, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsGroupImage, Converter={StaticResource BoolToVisibility}}">
                    <Button Command="{Binding SetModeCommand}" CommandParameter="Backup"
                            Content="{loc:Loc ModeBackup}" Padding="14,5" FontSize="12.5" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource MutedFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBackupMode}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetModeCommand}" CommandParameter="Restore"
                            Content="{loc:Loc ModeRestore}" Padding="14,5" FontSize="12.5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource MutedFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRestoreMode}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsGroupTrouble, Converter={StaticResource BoolToVisibility}}">
                    <Button Command="{Binding SetModeCommand}" CommandParameter="FixBoot"
                            Content="{loc:Loc ModeFixBoot}" Padding="14,5" FontSize="12.5" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource MutedFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFixBootMode}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetModeCommand}" CommandParameter="BootUsb"
                            Content="{loc:Loc ModeBootUsb}" Padding="14,5" FontSize="12.5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource MutedFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBootUsbMode}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessInk}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- ===== 클론 모드 ===== -->
            <Grid Visibility="{Binding IsCloneMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ① 디스크 선택 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10"
                        VerticalAlignment="Top" Panel.ZIndex="1">
                <Border Style="{StaticResource StepNumber}">
                    <TextBlock Text="1" Style="{StaticResource StepNumberText}" />
                </Border>
                <TextBlock Text="{loc:Loc Step1Title}" Style="{StaticResource StepTitle}" />
                <TextBlock Text="{loc:Loc Step1Subtitle}" Style="{StaticResource Micro}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <Grid Grid.Row="0" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <!-- 목록·막대 -->
                    <RowDefinition Height="Auto" />
                    <!-- 옵션(왼쪽) — 오른쪽 칸과 같은 행이라 윗선이 자동으로 맞습니다 -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--
                    원본 — 두 열은 위에서부터 차곡차곡 쌓습니다. DockPanel로 막대를 아래에
                    붙이면 한쪽에만 막대가 있을 때(대상 미선택) 그 열의 목록만 늘어나
                    두 목록의 아래끝이 어긋납니다.
                    열 제목 높이(26)와 목록 높이(260)를 양쪽에 똑같이 박아 가로줄을 맞춥니다.
                -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Height="26" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc SourceReadLabel}" Style="{StaticResource SubHeading}"
                                   FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        <!--
                            글자 색은 버튼 안 TextBlock에 직접 줍니다. 기본 Button 템플릿의
                            ContentPresenter가 Foreground를 문자열 내용에 전달하지 않아, Button에
                            Foreground를 줘도 글자색이 안 바뀝니다. 명시적 TextBlock이 확실합니다.
                        -->
                        <Button Command="{Binding RefreshDisksCommand}"
                                Padding="8,3" MinWidth="0" Margin="12,0,0,0" VerticalAlignment="Center"
                                BorderBrush="{StaticResource Success}">
                            <TextBlock Text="{loc:Loc Refresh}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Success}" />
                        </Button>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedSource}"
                             Style="{StaticResource DiskListStyle}" Height="260" />

                    <ContentControl Content="{Binding SourceLayout}"
                                    ContentTemplate="{StaticResource DiskLayoutTemplate}"
                                    Visibility="{Binding SourceLayout,
                                                 Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <!-- 화살표 -->
                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="&#x2192;" FontSize="20" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Text="{loc:Loc CloneArrow}" Style="{StaticResource Micro}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 대상 — 높이는 원본 열과 같은 값이어야 가로줄이 맞습니다. -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <Grid Height="26" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc TargetWriteLabel}" VerticalAlignment="Center"
                                   Style="{StaticResource SubHeading}" FontWeight="Bold"
                                   Foreground="{StaticResource Danger}" />
                    </Grid>

                    <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedTarget}"
                             Style="{StaticResource DiskListStyle}" Height="260" />

                    <ContentControl Content="{Binding TargetLayout}"
                                    ContentTemplate="{StaticResource DiskLayoutTemplate}"
                                    Visibility="{Binding TargetLayout,
                                                 Converter={StaticResource NullToVisibility}}" />
                </StackPanel>

                <!--
                    남는 공간 처리 — 대상 막대 바로 아래(오른쪽 칸). 디스크를 보는 자리와
                    결정하는 자리를 같게 둡니다. 옵션 영역까지 내려가면 무엇에 대한 선택인지
                    다시 떠올려야 합니다.

                    세 방법은 같은 질문의 답이라 라디오로 묶었습니다. 예전에는 별개 체크박스라
                    둘 다 켤 수 있었고, 그러면 하나가 조용히 무시됐습니다.
                    남는 공간이 없으면 묶음 전체를 숨깁니다 — 고를 이유가 없습니다.
                -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0"
                            Visibility="{Binding HasFreeSpace, Converter={StaticResource BoolToVisibility}}">

                    <!--
                        복제 후 예상 배치 — 위 대상 막대와 같은 모양으로 그리고 머리글로만 시점을
                        가릅니다. 한쪽만 다르게 그리면 다른 의미의 그래프로 착각합니다.
                        선택을 바꾸면 즉시 다시 그려져, 결과를 보면서 고를 수 있습니다.
                    -->
                    <ContentControl Content="{Binding TargetAfterLayout}"
                                    ContentTemplate="{StaticResource DiskLayoutTemplate}"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding TargetAfterLayout,
                                                 Converter={StaticResource NullToVisibility}}" />

                    <!--
                        막대가 사라진 자리에서 이유를 말합니다. 같은 문구가 시작 버튼 아래에도
                        뜨지만 그곳은 화면 한참 아래라, 설정을 만지는 동안에는 보이지 않습니다.
                    -->
                    <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
                            BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,10"
                            Visibility="{Binding HasFreeSpaceError,
                                         Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding FreeSpaceError}" Style="{StaticResource Caption}"
                                   Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                    </Border>

                    <!-- 접힌 상태에서 보이는 것은 이 <b>한 줄</b>이 전부입니다.
                         "뒤쪽 칸은 밀립니다"와 "손잡이를 끌어 조정할 수 있습니다"도 적어 봤지만,
                         바로 위 "변경 후" 막대가 이미 둘 다 보여 줍니다 — 복구가 끝으로 간 것도,
                         손잡이가 달려 있는 것도. 그림이 말하는 것을 글로 또 말하면 넉 줄이 되고,
                         그러면 정작 이 한 줄도 안 읽힙니다. -->
                    <TextBlock Text="{Binding FreeSpaceSummary}" Style="{StaticResource StepTitle}"
                               TextWrapping="Wrap" Margin="0,0,0,6" />

                    <!-- 다르게 하고 싶은 사람만 펼칩니다. 아무것도 없애지 않았습니다. -->
                    <Expander Header="{loc:Loc FreeSpaceReconfigure}" IsExpanded="{Binding IsFreeSpaceOpen}"
                              Margin="0,0,0,4">
                      <StackPanel Margin="0,10,0,0">

                    <RadioButton GroupName="FreeSpace" IsChecked="{Binding FreeSpaceLeave}"
                                 VerticalContentAlignment="Top" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc FreeSpaceLeaveTitle}" Style="{StaticResource Body}" />
                            <TextBlock Text="{loc:Loc FreeSpaceLeaveDesc}"
                                       Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="FreeSpace" IsChecked="{Binding FreeSpaceExpandLast}"
                                 VerticalContentAlignment="Top" Margin="0,0,0,9">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc FreeSpaceMergeTitle}" Style="{StaticResource Body}" />
                            <TextBlock Text="{loc:Loc FreeSpaceMergeDesc}"
                                       Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="FreeSpace" IsChecked="{Binding FreeSpaceGrowPartition}"
                                 IsEnabled="{Binding CanResize}"
                                 VerticalContentAlignment="Top" Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc FreeSpaceResizeTitle}" Style="{StaticResource Body}" />
                            <TextBlock Text="{loc:Loc FreeSpaceResizeDesc}"
                                       Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                        </StackPanel>
                    </RadioButton>

                    <!--
                        회색이 된 이유를 그 자리에서 말합니다. 항목 설명의 한 줄로는 막는
                        네 조건 중 하나일 뿐이라, 나머지 경우에는 왜 못 고르는지 알 방법이 없고
                        적어 둔 그 하나조차 흘려보게 됩니다.
                        RadioButton 바깥에 둡니다 — 안에 넣으면 비활성 상태라 같이 흐려집니다.
                    -->
                    <TextBlock Text="{Binding ResizeBlockedReason}" Margin="24,0,0,4"
                               Style="{StaticResource Micro}" Foreground="{StaticResource Warning}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasResizeBlockedReason,
                                            Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Margin="24,4,0,0"
                                Visibility="{Binding ShowGrowDetails, Converter={StaticResource BoolToVisibility}}">
                        <!--
                            넓힐 파티션을 칩으로 고릅니다. 드롭다운은 열어야 무엇이 있는지
                            보이지만, 후보는 보통 한둘이라 펼쳐 두는 편이 낫습니다 —
                            고를 것이 하나뿐인데 드롭다운을 열게 하는 것은 헛수고입니다.
                        -->
                        <ItemsControl ItemsSource="{Binding ResizablePartitions}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="GrowTarget" Content="{Binding Label}"
                                                 Margin="0,0,6,4" Padding="10,4"
                                                 Style="{StaticResource ChipRadio}">
                                        <RadioButton.IsChecked>
                                            <Binding Path="IsSelected" Mode="TwoWay"
                                                     UpdateSourceTrigger="PropertyChanged" />
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ResizeFillRadio" GroupName="ResizeSize"
                                         IsChecked="{Binding ResizeFillRemaining}"
                                         Content="{loc:Loc AllRemainingSpace}" VerticalContentAlignment="Center"
                                         Margin="0,0,14,0" FontSize="12" />
                            <!--
                                두 라디오 모두 뷰모델이 받쳐야 합니다. 한쪽만 묶어 두면 나머지
                                한쪽의 선택은 화면에만 있어서, 바인딩이 다시 적용될 때 조용히
                                '남는 공간 전부'로 돌아갑니다 — 입력한 크기 대신 남는 공간
                                전부를 쓰게 되는데 화면은 그렇게 보이지 않습니다.
                            -->
                            <RadioButton x:Name="ResizeSizeRadio" GroupName="ResizeSize"
                                         IsChecked="{Binding ResizeUseCustomSize}"
                                         Content="{loc:Loc ResizeCustomSize}" VerticalContentAlignment="Center"
                                         Margin="0,0,8,0" FontSize="12" />

                            <!-- 입력칸이 스스로 설명합니다: 231.32 GB → [ 464.20 ] GB.
                                 각주에 "'새 총 크기'는 늘린 뒤의 전체 크기입니다(추가할 크기가
                                 아닙니다)"라고 적어 두었던 문장이 이 배치로 필요 없어집니다. -->
                            <TextBlock Text="{Binding ResizeCurrentSizeText}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource Muted}" />
                            <TextBlock Text=" → " VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource Muted}" />
                            <!--
                                기본 UpdateSourceTrigger(LostFocus)면 숫자를 다 치고도 다른 곳을
                                누르기 전까지 막대와 시작 버튼이 옛 값 그대로입니다. 치는 대로
                                결과를 보여 줘야 크기를 가늠하며 고를 수 있습니다.
                            -->
                            <TextBox Width="70" VerticalContentAlignment="Center"
                                     Text="{Binding ResizeSizeGb, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsChecked, ElementName=ResizeSizeRadio}" />
                            <TextBlock Text=" GB" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{StaticResource Muted}" />
                        </StackPanel>

                        <!-- 고른 대로 두면 바란 것과 다른 일이 일어나는 경우를 그 자리에서 말합니다.
                             막지는 않습니다 — 복구 칸을 일부러 넓히는 경우도 있습니다. -->
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Micro}" Margin="0,8,0,0"
                                   Foreground="{StaticResource Warning}" MaxWidth="560"
                                   HorizontalAlignment="Left"
                                   Text="{Binding ResizeChoiceWarning}"
                                   Visibility="{Binding HasResizeChoiceWarning,
                                                Converter={StaticResource BoolToVisibility}}" />

                        <!-- 목록에서 빠진 파티션이 있을 때만. 늘 띄워 두면 그 말이 필요 없는
                             대부분에게는 읽을 것만 한 줄 늘어납니다. -->
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Micro}" Margin="0,6,0,0"
                                   Text="{loc:Loc ResizeNtfsOnly}" MaxWidth="560"
                                   HorizontalAlignment="Left"
                                   Visibility="{Binding SomePartitionsNotResizable,
                                                Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                      </StackPanel>
                    </Expander>
                </StackPanel>

                <!--
                    ② 옵션 — 원본 막대 아래(왼쪽 칸). 원본 쪽은 볼 것만 있어 세로 공간이 남고,
                    결정할 것이 있는 대상 쪽만 길어지던 불균형을 여기서 해소합니다.
                    설명을 라벨 아래로 내려 행이 화면 끝까지 늘어나지 않게 했습니다.
                -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="2" Style="{StaticResource StepNumberText}" />
                        </Border>
                        <TextBlock Text="{loc:Loc Step2Title}" Style="{StaticResource StepTitle}" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="{loc:Loc SafetyLabel}" Style="{StaticResource SectionLabel}" Margin="0,0,0,7" />

                            <!-- VSS를 쓸 수 없을 때 이유·조치를 보여 줍니다 — 회색 체크박스만으로는
                                 사용자가 원인도 해결법도 알 수 없었습니다(실기 피드백). -->
                            <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
                                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,9"
                                    Visibility="{Binding SnapshotUnavailableText, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding SnapshotUnavailableText}" TextWrapping="Wrap"
                                           Style="{StaticResource Micro}" Foreground="{StaticResource Danger}" />
                            </Border>

                            <CheckBox IsChecked="{Binding UseSnapshot}" IsEnabled="{Binding IsSnapshotAvailable}"
                                      VerticalContentAlignment="Top" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc VssTitle}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{loc:Loc VssDesc}"
                                               Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding VerifyAfterClone}"
                                      VerticalContentAlignment="Top" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc VerifyTitle}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{loc:Loc VerifyDesc}"
                                               Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding ZeroFillBadSectors}"
                                      VerticalContentAlignment="Top" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc SkipBadTitle}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{loc:Loc SkipBadDesc}"
                                               Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{loc:Loc BehaviorLabel}" Style="{StaticResource SectionLabel}" Margin="0,0,0,7" />

                            <CheckBox IsChecked="{Binding SkipUnusedBlocks}" IsEnabled="{Binding UseSnapshot}"
                                      VerticalContentAlignment="Top" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc SmartTitle}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{loc:Loc SmartDesc}"
                                               Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </CheckBox>

                            <CheckBox IsChecked="{Binding UniversalRestore}"
                                      VerticalContentAlignment="Top" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc NewHwTitle}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{loc:Loc NewHwDesc}"
                                               Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </CheckBox>

                            <!--
                                BIOS→UEFI 자동 변환. 되돌릴 수 없는 변환이라 기본 꺼짐이며, 켜면 클론
                                직후 자동으로 GPT/UEFI로 바꿔 완료 화면의 'UEFI로 변환' 버튼을 누를
                                필요가 없습니다. GPT 원본에는 영향 없습니다.
                            -->
                            <CheckBox IsChecked="{Binding AutoConvertUefi}"
                                      VerticalContentAlignment="Top" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc AutoUefiTitle}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{loc:Loc AutoUefiDesc}"
                                               Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </CheckBox>

                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Grid>

            <!-- 하단 패널 -->
            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="16,13" Margin="0,14,0,0">
                <StackPanel>

                    <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource Danger}"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding LoadError, Converter={StaticResource NullToVisibility}}" />

                    <!-- ③ 확인 후 실행 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <Border Style="{StaticResource StepNumber}">
                            <TextBlock Text="3" Style="{StaticResource StepNumberText}" />
                        </Border>
                        <TextBlock Text="{loc:Loc Step3Title}" Style="{StaticResource StepTitle}" />
                    </StackPanel>

                    <!-- 안전 점검 결과 -->
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding SafetyIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="3" Padding="5,1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToLabel}}"
                                                       Foreground="White" Style="{StaticResource Micro}" FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                                   Style="{StaticResource Caption}" Margin="8,0,0,0"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--
                        확인 입력과 실행을 한 덩어리로 묶습니다.
                        예전에는 안내문 아래 작은 입력란이 있고 버튼은 저 멀리 오른쪽 아래에 있어서,
                        가장 안전에 중요한 컨트롤이 가장 눈에 안 띄었습니다. 또 버튼이 회색일 때
                        무엇을 더 해야 하는지 알 수 없었습니다 — 이제 이유를 바로 옆에 적습니다.
                    -->
                    <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource DangerBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="14,10" Margin="0,6,0,0">
                        <!--
                            버튼과 안내 글을 한 줄에 세로 중앙으로 맞춥니다. 예전에는 큰 버튼이 위에,
                            안내 글이 아래에 떨어져 빈 공간이 컸습니다. 왼쪽에 글(확인 프롬프트·입력란·
                            비활성 사유·주의), 오른쪽에 버튼을 두어 박스 높이를 글 내용에 맞춥니다.
                        -->
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc StartClone}" Command="{Binding StartCommand}"
                                    Style="{StaticResource DangerButton}" MinWidth="130" Padding="20,9"
                                    Margin="14,0,0,0" VerticalAlignment="Center" />

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConfirmationPrompt}" TextWrapping="Wrap"
                                           Style="{StaticResource Caption}" Foreground="{StaticResource DangerInk}" Margin="0,0,0,7"
                                           Visibility="{Binding NeedsConfirmation,
                                                        Converter={StaticResource BoolToVisibility}}" />

                                <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="9,7" FontSize="13" FontFamily="Consolas, D2Coding"
                                         VerticalContentAlignment="Center" Margin="0,0,0,7"
                                         Visibility="{Binding NeedsConfirmation,
                                                      Converter={StaticResource BoolToVisibility}}" />

                                <!-- 버튼이 왜 비활성인지 -->
                                <TextBlock Text="{Binding BlockedReason}" TextWrapping="Wrap"
                                           Style="{StaticResource Micro}" Foreground="{StaticResource DangerInk}"
                                           Visibility="{Binding HasBlockedReason,
                                                        Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{loc:Loc IrreversibleWarn}"
                                           Style="{StaticResource Micro}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </Border>
            </Grid>
            <!-- ===== 클론 모드 끝 ===== -->

            <!-- ===== 이미지 백업 모드 (디스크 → .vhdx) ===== -->
            <StackPanel
                        Visibility="{Binding IsBackupMode, Converter={StaticResource BoolToVisibility}}">

                <!-- 왜 백업해 두어야 하는지 — 기능 설명보다 먼저 말해 줍니다.
                     상자(배경·테두리)는 두지 않습니다. 화면이 넓어지면서 색 띠가 가로로 길게
                     누워 정작 글보다 상자가 먼저 눈에 들어왔습니다. -->
                <StackPanel Margin="0,4,0,14">
                    <TextBlock Text="{loc:Loc BackupRecommendTitle}" Style="{StaticResource Body}" FontWeight="Bold" />
                    <TextBlock Text="{loc:Loc BackupRecommendDesc}" Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                    <TextBlock Text="{loc:Loc BackupSourceLabel}" Style="{StaticResource SubHeading}"
                               FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <Button Command="{Binding RefreshDisksCommand}" Padding="8,3" MinWidth="0" Margin="12,0,0,0"
                            VerticalAlignment="Center" BorderBrush="{StaticResource Success}">
                        <TextBlock Text="{loc:Loc Refresh}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Success}" />
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedSource}"
                         Style="{StaticResource DiskListStyle}" Height="240" />

                <ContentControl Content="{Binding SourceLayout}" ContentTemplate="{StaticResource DiskLayoutTemplate}"
                                Visibility="{Binding SourceLayout, Converter={StaticResource NullToVisibility}}" />

                <TextBlock Text="{loc:Loc BackupPathLabel}" Style="{StaticResource SectionLabel}" Margin="0,16,0,7" />
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc Browse}" Command="{Binding BrowseImageSaveCommand}"
                            Padding="14,7" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ImagePath}" IsReadOnly="True" VerticalContentAlignment="Center"
                             Padding="9,7" FontFamily="Consolas, D2Coding" />
                </DockPanel>
                <!-- 기존 백업 파일을 고르면 증분 백업으로 이어짐을 시작 전에 예고합니다. -->
                <Border Background="{StaticResource SelectionSoft}" CornerRadius="8" Padding="10,8" Margin="0,6,0,0"
                        Visibility="{Binding BackupChainNotice, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding BackupChainNotice}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <CheckBox IsChecked="{Binding UseSnapshot}" IsEnabled="{Binding IsSnapshotAvailable}"
                              Content="{loc:Loc VssTitle}" Margin="0,0,18,0" />
                    <CheckBox IsChecked="{Binding SkipUnusedBlocks}" IsEnabled="{Binding UseSnapshot}"
                              Content="{loc:Loc SmartTitle}" Margin="0,0,18,0" />
                    <CheckBox IsChecked="{Binding VerifyAfterClone}" Content="{loc:Loc VerifyTitle}" />
                </StackPanel>

                <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
                        BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0"
                        Visibility="{Binding SnapshotUnavailableText, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding SnapshotUnavailableText}" TextWrapping="Wrap"
                               Style="{StaticResource Micro}" Foreground="{StaticResource Danger}" />
                </Border>

                <TextBlock Text="{loc:Loc BackupHint}" Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,10,0,0" />

                <Button Content="{loc:Loc BackupStartBtn}" Command="{Binding BackupCommand}"
                        Style="{StaticResource AccentButton}" HorizontalAlignment="Left"
                        MinWidth="140" Padding="20,10" Margin="0,16,0,0" />
            </StackPanel>

            <!-- ===== 이미지 복원 모드 (.vhdx → 디스크) ===== -->
            <StackPanel
                        Visibility="{Binding IsRestoreMode, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="{loc:Loc RestoreImageLabel}" Style="{StaticResource SectionLabel}" Margin="0,4,0,7" />
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="{loc:Loc Browse}" Command="{Binding BrowseImageOpenCommand}"
                            Padding="14,7" Margin="8,0,0,0" />
                    <TextBox Text="{Binding ImagePath}" IsReadOnly="True" VerticalContentAlignment="Center"
                             Padding="9,7" FontFamily="Consolas, D2Coding" />
                </DockPanel>
                <!-- 이미지 빠른 확인: 선택 즉시 부착해 구조를 읽은 결과. 복원 시작 시 chkdsk 포함
                     심층 검사가 한 번 더 돕니다. -->
                <TextBlock Text="{Binding ImageCheckStatus}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ImageCheckStatus, Converter={StaticResource NullToVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Foreground" Value="{StaticResource Danger}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImageCheckOk}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Success}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,7">
                    <TextBlock Text="{loc:Loc RestoreTargetLabel}" Style="{StaticResource SubHeading}"
                               FontWeight="Bold" Foreground="{StaticResource Danger}" VerticalAlignment="Center" />
                    <Button Command="{Binding RefreshDisksCommand}" Padding="8,3" MinWidth="0" Margin="12,0,0,0"
                            VerticalAlignment="Center" BorderBrush="{StaticResource Success}">
                        <TextBlock Text="{loc:Loc Refresh}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Success}" />
                    </Button>
                </StackPanel>
                <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedTarget}"
                         Style="{StaticResource DiskListStyle}" Height="220" />
                <ContentControl Content="{Binding TargetLayout}" ContentTemplate="{StaticResource DiskLayoutTemplate}"
                                Visibility="{Binding TargetLayout, Converter={StaticResource NullToVisibility}}" />

                <CheckBox IsChecked="{Binding UniversalRestore}" VerticalContentAlignment="Top" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc NewHwTitle}" Style="{StaticResource Body}" />
                        <TextBlock Text="{loc:Loc NewHwDesc}" Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,1,0,0" />
                    </StackPanel>
                </CheckBox>

                <!-- 자동 축소 안내: 대상이 이미지보다 작으면 어느 파티션을 얼마로 줄일지 앱이
                     자동 계산해 알려만 줍니다(사용자 입력 없음 — 맞춤 클론과 같은 철학). -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                        Visibility="{Binding HasShrinkAutoText, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ShrinkAutoText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{loc:Loc RestoreHint}" Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,10,0,0" />

                <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource DangerBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{loc:Loc RestoreStartBtn}" Command="{Binding RestoreImageCommand}"
                                Style="{StaticResource DangerButton}" MinWidth="130" Padding="20,9"
                                Margin="14,0,0,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RestoreConfirmPrompt}" TextWrapping="Wrap"
                                       Style="{StaticResource Caption}" Foreground="{StaticResource DangerInk}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="9,7" FontSize="13" FontFamily="Consolas, D2Coding"
                                     VerticalContentAlignment="Center" Margin="0,0,0,7" />
                            <TextBlock Text="{loc:Loc RestoreWarn}" Style="{StaticResource Micro}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- ===== 부팅 복구 모드 (독립 도구 — 복제 없이 검사·복구) ===== -->
            <StackPanel
                        Visibility="{Binding IsFixBootMode, Converter={StaticResource BoolToVisibility}}">

                <!-- 백업 화면과 같은 모양 — 굵은 첫 줄이 무엇을 하는 자리인지 말하고,
                     그 아래 흐린 줄이 덧붙입니다. 상자는 두지 않습니다. -->
                <StackPanel Margin="0,4,0,14">
                    <TextBlock Text="{loc:Loc FixBootTitle}" Style="{StaticResource Body}" FontWeight="Bold" />
                    <TextBlock Text="{loc:Loc FixBootHint}" Style="{StaticResource Micro}"
                               TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                    <TextBlock Text="{loc:Loc FixBootTargetLabel}" Style="{StaticResource SubHeading}"
                               FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <Button Command="{Binding RefreshDisksCommand}" Padding="8,3" MinWidth="0" Margin="12,0,0,0"
                            VerticalAlignment="Center" BorderBrush="{StaticResource Success}">
                        <TextBlock Text="{loc:Loc Refresh}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Success}" />
                    </Button>
                </StackPanel>
                <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedTarget}"
                         Style="{StaticResource DiskListStyle}" Height="220" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="{loc:Loc BootCheckBtn}" Command="{Binding BootCheckCommand}"
                            Style="{StaticResource AccentButton}" MinWidth="130" Padding="16,8" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Micro}"
                               TextWrapping="Wrap" MaxWidth="440" Text="{loc:Loc FixBootReadOnlyNote}" />
                </StackPanel>

                <TextBlock Text="{loc:Loc Checking}" Margin="0,8,0,0" Style="{StaticResource Caption}"
                           Visibility="{Binding IsBootChecking, Converter={StaticResource BoolToVisibility}}" />

                <!-- 검사 결과 (완료 화면과 같은 표시) -->
                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding BootCheckRan, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BootCheckVerdict}" TextWrapping="Wrap" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BootCheckVerdictIsGood}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding BootCheckItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="3" Padding="5,1"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Background="{Binding StatusBrush}">
                                                <TextBlock Text="{Binding Mark}" Foreground="White"
                                                           Style="{StaticResource Micro}" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Micro}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 복구는 버튼 하나입니다. 예전에는 '부팅 복구'와 '그래도 복구 해보기'가
                         따로 있었는데, 둘 다 같은 명령을 부르고 서로 배타적이라 절대 함께 뜨지
                         않았습니다 — 사용자에게는 "복구가 두 종류인가?"로만 보였습니다.
                         설명(RepairBootHint)만 상황에 따라 바뀝니다. -->
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource BootRepairActionTemplate}" />
                </StackPanel>

                <!-- 진단 리포트 저장 — 오프라인 브리지(계획서 §2.5).
                     부팅이 막힌 PC에는 Claude도 인터넷도 없습니다. 그 PC에서 이 파일을 만들어
                     USB로 옮겨야 정상 PC에서 분석할 수 있습니다. Claude 연결과 무관하게
                     동작해야 하므로 이 화면에 있습니다.

                     ⚠ 예전에는 [부팅 검사]와 그 결과 '사이'에 테두리 상자로 놓여 있었습니다.
                       검사하러 온 사람의 눈길을 다른 일이 가로막고 있었던 것입니다. 꼭 필요한
                       기능이지만 대부분은 평생 쓰지 않으므로, 결과 아래로 내리고 접어 둡니다. -->
                <Expander Header="{loc:Loc DiagSaveExpander}" IsExpanded="False" Margin="0,18,0,0">
                  <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{loc:Loc DiagSaveHint}" Style="{StaticResource Micro}"
                               TextWrapping="Wrap" MaxWidth="560" Margin="0,0,0,8" />

                    <CheckBox IsChecked="{Binding DiagIncludeDetails}"
                              Content="{loc:Loc DiagIncludeDetails}" />
                    <TextBlock Text="{loc:Loc DiagIncludeHint}" Style="{StaticResource Micro}"
                               Margin="24,2,0,10" TextWrapping="Wrap" MaxWidth="560" />

                    <Button Content="{loc:Loc DiagSaveBtn}" Command="{Binding SaveDiagnosticCommand}"
                            HorizontalAlignment="Left" MinWidth="130" Padding="14,7" />

                    <TextBlock Text="{loc:Loc DiagCollecting}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="{Binding IsCollectingDiagnostic, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding DiagnosticMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding DiagnosticSaved, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiagnosticFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </Expander>
            </StackPanel>

            <!-- ===== Claude 연결 (로컬 MCP 통로) =====
                 기본은 꺼짐입니다 — 디스크를 읽는 통로를 사용자 모르게 열어두지 않습니다.

                 대화창은 이 탭이 아니라 오른쪽 패널에 있습니다. 여기 남는 것은 둘입니다.
                   ① 연결 — Claude 쪽에 등록하고 통로를 여는 것
                   ② 감사 — Claude가 무엇을 봤는지 확인하는 것
                 주소·토큰·명령은 버튼이 안 될 때의 대비책이라 [수동으로 연결하기] 안으로
                 넣습니다. 그것이 늘 펼쳐져 있으면 초보자가 "이걸 해야 하나" 하고 멈춥니다. -->
            <StackPanel
                        Visibility="{Binding IsAssistantMode, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="{loc:Loc McpTitle}" Style="{StaticResource Body}" FontWeight="Bold"
                           Margin="0,4,0,2" />
                <TextBlock Text="{loc:Loc McpIntro}" Style="{StaticResource Micro}"
                           TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,16" />

                <!-- 상자를 두지 않습니다. 다른 화면과 같은 규칙 — 버튼 한 줄 + 왜 필요한지 한 줄. -->
                <StackPanel Margin="0,0,0,16"
                            Visibility="{Binding CanConnectToClaude, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ConnectToClaudeButton" Click="ConnectToClaude_Click"
                                Content="{loc:Loc McpConnectButton}"
                                Padding="18,9" VerticalAlignment="Top"
                                Style="{StaticResource AccentButton}" />
                        <TextBlock Text="{loc:Loc McpConnectHint}" Style="{StaticResource Micro}"
                                   TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 켜기 전에 정해야 합니다 — 이미 나간 정보는 되돌릴 수 없으므로,
                     통로가 열려 있는 동안에는 바꾸지 못하게 잠급니다. -->
                <CheckBox IsChecked="{Binding McpShareDetails}"
                          Content="{loc:Loc McpShareDetails}" Margin="0,0,0,2">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding McpRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CheckBox.Style>
                </CheckBox>
                <TextBlock Text="{loc:Loc McpShareDetailsHint}" Style="{StaticResource Micro}"
                           TextWrapping="Wrap" Margin="24,0,0,14" MaxWidth="540" HorizontalAlignment="Left" />

                <Button Command="{Binding ToggleMcpCommand}" Content="{Binding McpToggleLabel}"
                        HorizontalAlignment="Left" Padding="18,9" Margin="0,0,0,10" />

                <TextBlock Text="{Binding McpStatusText}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="0,0,0,10" MaxWidth="560" HorizontalAlignment="Left"
                           Visibility="{Binding McpStatusText, Converter={StaticResource NullToVisibility}}" />

                <!-- ===== 통로가 열렸을 때 ===== -->
                <StackPanel Visibility="{Binding McpRunning, Converter={StaticResource BoolToVisibility}}">

                    <!-- 감사 기록. 앱은 "읽기만 합니다"라고 말하면서 정작 무엇을 읽었는지는
                         보여주지 않았습니다 — 그 말을 확인할 방법이 사용자에게 없었다는 뜻입니다.
                         이제 이 탭의 주인공이라, 상자 안에 파묻지 않고 앞으로 냅니다. -->
                    <TextBlock Text="{loc:Loc McpActivityTitle}" Style="{StaticResource Body}"
                               FontWeight="Bold" Margin="0,8,0,2" />
                    <TextBlock Text="{loc:Loc McpActivityHint}" Style="{StaticResource Micro}"
                               TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />

                    <TextBlock Text="{loc:Loc McpActivityEmpty}" Style="{StaticResource Caption}"
                               Margin="0,10,0,0"
                               Visibility="{Binding HasMcpActivity, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                            CornerRadius="8" Margin="0,10,0,0" MaxWidth="640" HorizontalAlignment="Left"
                            Visibility="{Binding HasMcpActivity, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding McpActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="10,5">
                                            <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11.5"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />

                                            <!-- 종류 배지 — 도구 이름보다 이쪽이 사용자의 관심사입니다. -->
                                            <Border CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource ChipNeutral}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource ChipSuccess}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProposal}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource ChipWarning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding KindLabel}" FontSize="10.5" FontWeight="SemiBold" />
                                            </Border>

                                            <TextBlock Text="{Binding Tool}" FontFamily="Consolas" FontSize="11.5"
                                                       Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Failed}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Margin="8,0,0,0"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />

                                            <TextBlock Text="{Binding Elapsed}" FontSize="10.5" Margin="8,0,0,0"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- 손으로 연결하는 방법. 버튼이 생기기 전에는 이것이 유일한 길이었지만,
                         이제는 버튼이 안 될 때의 대비책입니다. 주소·토큰도 여기로 들어옵니다 —
                         [Claude에 연결하기]를 쓰는 사람은 볼 일이 없는 값입니다.

                         ⚠ Claude 앱의 "커스텀 커넥터 추가" 화면은 쓸 수 없습니다. 그 화면은 주소가
                            https로 시작할 것을 요구하는데, 이 통로는 이 컴퓨터 안에서만 통하는
                            http이기 때문입니다(2026-08-10 실기에서 거절 확인). -->
                    <Expander Header="{loc:Loc McpAdvancedLabel}" IsExpanded="False" Margin="0,20,0,0">
                      <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{loc:Loc McpCommandLabel}" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding McpAddCommand, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" Margin="0,4,0,4"
                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc McpCommandHint}" Style="{StaticResource Micro}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding CopyMcpAddCommandCommand}" Content="{loc:Loc McpCommandCopy}"
                                    Padding="14,7" Margin="0,0,8,0" />
                            <Button Command="{Binding CopyMcpSettingsCommand}" Content="{loc:Loc McpCopyButton}"
                                    Padding="14,7" Margin="0,0,8,0" />
                            <Button Command="{Binding CopyMcpConnectorUrlCommand}" Content="{loc:Loc McpConnectorCopy}"
                                    Padding="14,7" />
                        </StackPanel>

                        <TextBlock Text="{loc:Loc McpUrlLabel}" Style="{StaticResource Caption}" Margin="0,16,0,0" />
                        <TextBox Text="{Binding McpUrl, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" Margin="0,2,0,8"
                                 BorderThickness="0" Background="Transparent" />

                        <TextBlock Text="{loc:Loc McpTokenLabel}" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding McpToken, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" Margin="0,2,0,8"
                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />

                        <!-- 헤더를 못 보내는 도구를 위한 참고용. 화면 설정에서는 쓸 수 없다는 것을
                             문구에 분명히 적습니다 — 그러지 않으면 또 막다른 길로 보냅니다. -->
                        <TextBlock Text="{loc:Loc McpConnectorLabel}" Style="{StaticResource Caption}" />
                        <TextBox Text="{Binding McpConnectorUrl, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12" Margin="0,2,0,4"
                                 BorderThickness="0" Background="Transparent" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc McpConnectorHint}" Style="{StaticResource Micro}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />

                        <!-- ⚠ 이 버튼은 Collapsed로 숨겨져 있으면서 설명만 화면에 떠 있었습니다.
                             누를 것이 없는 안내는 사용자를 찾아 헤매게 만듭니다. 함께 보입니다. -->
                        <Button Command="{Binding ResetMcpTokenCommand}" Content="{loc:Loc McpResetToken}"
                                HorizontalAlignment="Left" Padding="14,7" Margin="0,16,0,0" />
                        <TextBlock Text="{loc:Loc McpResetTokenHint}" Style="{StaticResource Micro}"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,6,0,0" />
                      </StackPanel>
                    </Expander>
                </StackPanel>
            </StackPanel>

            <!-- ===== 부팅 USB 모드 (WinPE 응급 USB 만들기) ===== -->
            <StackPanel
                        Visibility="{Binding IsBootUsbMode, Converter={StaticResource BoolToVisibility}}">

                <TextBlock Text="{loc:Loc BootUsbHint}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="0,4,0,10" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                    <TextBlock Text="{loc:Loc BootUsbTargetLabel}" Style="{StaticResource SubHeading}"
                               FontWeight="Bold" Foreground="{StaticResource Danger}" VerticalAlignment="Center" />
                    <Button Command="{Binding RefreshDisksCommand}" Padding="8,3" MinWidth="0" Margin="12,0,0,0"
                            VerticalAlignment="Center" BorderBrush="{StaticResource Success}">
                        <TextBlock Text="{loc:Loc Refresh}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Success}" />
                    </Button>
                </StackPanel>
                <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedTarget}"
                         Style="{StaticResource DiskListStyle}" Height="200" />

                <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource DangerBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,14,0,0">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{loc:Loc BootUsbStartBtn}" Command="{Binding BuildBootUsbCommand}"
                                Style="{StaticResource DangerButton}" MinWidth="140" Padding="20,9"
                                Margin="14,0,0,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConfirmationPrompt}" TextWrapping="Wrap"
                                       Style="{StaticResource Caption}" Foreground="{StaticResource DangerInk}" Margin="0,0,0,7" />
                            <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="9,7" FontSize="13" FontFamily="Consolas, D2Coding"
                                     VerticalContentAlignment="Center" Margin="0,0,0,7" />
                            <TextBlock Text="{loc:Loc BootUsbWarn}" Style="{StaticResource Micro}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 진행 중: 진행 막대 + 퍼센트 + 단계 문구 + 취소 -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0"
                        Visibility="{Binding IsPeBuilding, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding PeProgress, StringFormat={}{0:0}%}" />
                            <ProgressBar Value="{Binding PeProgress, Mode=OneWay}" Maximum="100" Height="10"
                                         VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="{loc:Loc BootUsbCancelBtn}"
                                    Command="{Binding CancelBootUsbCommand}"
                                    Margin="12,0,0,0" Padding="12,5" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PeStatus}" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 완료: 결과 카드 (성공=초록, 실패=빨강) -->
                <Border BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,12,0,0"
                        Visibility="{Binding PeRan, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PeSuccess}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SuccessSoft}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" FontSize="17" Margin="0,0,10,0"
                                   VerticalAlignment="Center" FontFamily="Segoe UI Emoji">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="❌" />
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PeSuccess}" Value="True">
                                            <Setter Property="Text" Value="✔" />
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding PeStatus}" TextWrapping="Wrap" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PeSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                </Border>

                <TextBlock Text="{loc:Loc BootUsbAfterHint}" Style="{StaticResource Micro}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- ===== 2단계: 진행 중 ===== -->
        <Grid Grid.Row="1" Margin="40,14,40,16"
              Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Running}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="40"
                    VerticalAlignment="Center" MaxWidth="720">
                <StackPanel>
                    <TextBlock Text="{Binding ProgressPhase}" Style="{StaticResource Heading}"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding ProgressRegion}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,20"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock HorizontalAlignment="Center" FontSize="42" FontWeight="Light" Margin="0,0,0,8">
                        <Run Text="{Binding ProgressPercent, StringFormat={}{0:F1}, Mode=OneWay}" />
                        <Run Text="%" FontSize="24" Foreground="{StaticResource Muted}" />
                    </TextBlock>

                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="10"
                                 Foreground="{StaticResource Accent}" Background="{StaticResource NeutralSoft}"
                                 BorderThickness="0" Margin="0,0,0,24" />

                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc StatCopied}" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressBytes}" Style="{StaticResource Body}" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc StatSpeed}" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressSpeed}" Style="{StaticResource Body}" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc StatTimeLeft}" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressEta}" Style="{StaticResource Body}" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc StatElapsed}" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressElapsed}" Style="{StaticResource Body}" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                                MinWidth="110" Margin="0,0,10,0" />
                        <Button Content="{loc:Loc Cancel}" Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButton}" MinWidth="110" />
                    </StackPanel>

                    <TextBlock Text="{loc:Loc DoNotDisconnect}"
                               Style="{StaticResource Micro}"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 3단계: 결과 =====
             내용(부팅 검사·복구·UEFI 변환·파티션 확장·안전 제거)이 창 높이를 넘으면 스크롤합니다.
             예전에는 ScrollViewer가 없고 박스가 세로 중앙 정렬이라, 검사 결과가 길어지면 그 아래
             복구·변환·확장 버튼이 화면 밖으로 잘려 보이지 않았습니다. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Finished}">
        <Grid Margin="40,14,40,16">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="40"
                    VerticalAlignment="Top" MaxWidth="760">
                <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Heading}">
                                <Setter Property="FontSize" Value="22" />
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultIsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Style="{StaticResource Body}"
                               Margin="0,10,0,20" />

                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="6" Padding="16">
                        <TextBlock Text="{Binding ResultDetails}" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                   LineHeight="22" />
                    </Border>

                    <!-- 부팅 구성 검사 (클론 성공 시만 — 백업/복원 모드에선 숨김) -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding ShowCloneResultActions, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc BootCheckBtn}" Command="{Binding BootCheckCommand}"
                                    MinWidth="130" Padding="16,8" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Micro}" TextWrapping="Wrap" MaxWidth="440"
                                       Text="{loc:Loc BootCheckTip}" />
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Checking}" Margin="0,8,0,0" Style="{StaticResource Caption}"
                                   Visibility="{Binding IsBootChecking, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 검사 결과 -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding BootCheckRan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BootCheckVerdict}" TextWrapping="Wrap"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <!-- 판정에 따라 색이 바뀌므로 인라인 Style을 쓰되, 크기는 스케일에서 상속합니다. -->
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BootCheckVerdictIsGood}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding BootCheckItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" CornerRadius="3" Padding="5,1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Background="{Binding StatusBrush}">
                                                        <TextBlock Text="{Binding Mark}" Foreground="White"
                                                                   Style="{StaticResource Micro}" FontWeight="SemiBold" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Micro}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- 부팅 복구 — 부팅 복구 화면과 같은 부품을 씁니다(Window.Resources). -->
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource BootRepairActionTemplate}" />
                        </StackPanel>
                    </StackPanel>

                    <!--
                        UEFI 변환 — 원본이 BIOS 전용(MBR·활성 파티션, ESP 없음) 배치였을 때만.
                        그 사본은 레거시 부팅을 지원하는 하드웨어에서만 켜지고, NVMe M.2에는
                        레거시 옵션 ROM이 없어 아예 부팅되지 않습니다. '자동 변환' 옵션을 켜면 클론
                        직후 자동으로 변환되고, 껐으면 여기 버튼으로 직접 변환합니다.
                        섹션은 변환 가능하거나 이미 실행됐을 때 보이고(ShowUefiConvertSection),
                        설명·버튼은 아직 변환 전(UefiConvertAvailable)일 때만 — 변환 후엔 결과만 남깁니다.
                    -->
                    <!-- 상자를 두지 않습니다. 후속 작업이 넷인데 저마다 색 테두리 상자를
                         두르면 결과 화면이 상자 다섯 개가 됩니다 — 정작 무엇이 끝났는지가
                         묻힙니다. 버튼 한 줄 + 왜 필요한지 한 줄이면 충분합니다.
                         "무엇을 하나"는 버튼 이름이 이미 말합니다(ConvertUefiTip 삭제). -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding ShowUefiConvertSection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding UefiConvertAvailable, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="{loc:Loc ConvertUefiBtn}" Command="{Binding ConvertToUefiCommand}"
                                    MinWidth="130" Padding="16,8" VerticalAlignment="Top" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource Micro}" TextWrapping="Wrap" MaxWidth="440"
                                       HorizontalAlignment="Left"
                                       Text="{loc:Loc MakeBootableDesc}" />
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Converting}" Margin="0,6,0,0"
                                   Style="{StaticResource Caption}"
                                   Visibility="{Binding IsConvertingToUefi,
                                                Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding UefiConvertMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding UefiConvertRan,
                                                Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UefiConvertSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!--
                        복구 환경 안내 — 리사이즈로 복구 파티션이 밀렸을 때만.
                        부팅은 정상이라 사용자가 알아채지 못하고, 정작 복구가 필요한 순간에야
                        없다는 걸 알게 됩니다. 명령 한 줄이면 되는 일이라 여기서 말해 줍니다.
                    -->
                    <!-- 누를 것이 없는 안내입니다. 색 테두리 상자로 두르면 할 일이 있는
                         버튼들과 같은 무게로 보여, 정작 눌러야 할 것이 묻힙니다. -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding HasRecoveryHint, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{loc:Loc ReconnectWinre}" Style="{StaticResource Body}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Warning}" />
                        <TextBlock Text="{Binding RecoveryHint}" Style="{StaticResource Micro}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="560"
                                   HorizontalAlignment="Left" />
                    </StackPanel>

                    <!-- 파티션 확장 (대상에 남는 공간이 있을 때) -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding PartitionExpandAvailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc ExpandPartitionBtn}" Command="{Binding ExpandPartitionCommand}"
                                    MinWidth="130" Padding="16,8" />
                            <!-- "클론 중 자동 확장이 안 되면 이 버튼으로 마무리하세요"는 원래
                                 선택 화면의 각주에 있었습니다. 거기서는 할 수 있는 일이 없습니다 —
                                 버튼이 여기 있으니 설명도 여기 있어야 합니다. -->
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Micro}" TextWrapping="Wrap" MaxWidth="440"
                                       Text="{loc:Loc ExpandPartitionTip}" />
                        </StackPanel>

                        <TextBlock Text="{loc:Loc Expanding}" Margin="0,6,0,0" Style="{StaticResource Caption}"
                                   Visibility="{Binding IsExpandingPartition, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding PartitionExpandMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding PartitionExpandRan, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PartitionExpandSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--
                        대상 안전하게 제거 — 이동식(USB) 대상일 때만.
                        클론 후 대상을 다시 온라인으로 올리며 복제된 볼륨이 자동 마운트돼,
                        Windows "안전하게 제거"가 "장치 사용 중"으로 막힙니다. 이 버튼이 볼륨을
                        디스마운트하고 디스크를 오프라인으로 내려 그대로 뽑을 수 있게 합니다.
                    -->
                    <!-- 제목("대상 USB 안전하게 제거")이 버튼 이름("대상 안전하게 제거")과
                         거의 같아 두 번 읽히던 자리입니다. 제목과 상자를 함께 걷어냅니다. -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding SafeRemoveAvailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc SafeRemoveBtn}" Command="{Binding SafeRemoveTargetCommand}"
                                    MinWidth="130" Padding="16,8" VerticalAlignment="Top" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                                       Style="{StaticResource Micro}" TextWrapping="Wrap" MaxWidth="440"
                                       HorizontalAlignment="Left"
                                       Text="{loc:Loc SafeRemoveDesc}" />
                        </StackPanel>

                        <TextBlock Text="{loc:Loc SafeRemoveBusy}" Margin="0,6,0,0"
                                   Style="{StaticResource Caption}"
                                   Visibility="{Binding IsSafeRemoving,
                                                Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding SafeRemoveMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding SafeRemoveRan,
                                                Converter={StaticResource BoolToVisibility}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SafeRemoveSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Content="{loc:Loc StartOver}" Command="{Binding BackToSelectionCommand}"
                            Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                            Margin="0,20,0,0" MinWidth="120" Padding="20,10" />
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- ═════ Claude 대화 패널 (오른쪽) ═════
             막혔을 때 <b>하던 화면을 떠나지 않고</b> 물어보는 자리입니다. 부팅 복구 도중
             막혔는데 물어보려고 탭을 옮겨야 한다면 하던 것을 잃습니다.

             아래에 붙이는 방법도 생각했지만, 대화가 길어지면 그 높이로는 안 보입니다 —
             창 높이를 다 쓰는 옆이 맞습니다. 닫혀 있으면 폭이 0이라 화면은 지금까지와
             똑같습니다.

             부팅 USB(WinPE)에서는 열리지 않습니다 — 거기엔 Claude Code를 설치할 수 없고,
             그 자리는 윈도우가 아예 안 켜질 때 쓰는 마지막 수단입니다. -->
        <Border Grid.Row="1" Grid.Column="1" Width="400"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsChatOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="16,14,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- 제목 -->
                    <RowDefinition Height="Auto" />   <!-- 지금 무엇을 하던 중인지 -->
                    <RowDefinition Height="Auto" />   <!-- 첫 질문 버튼 -->
                    <RowDefinition Height="*" />      <!-- 대화 -->
                    <RowDefinition Height="Auto" />   <!-- 진행 상황 -->
                    <RowDefinition Height="Auto" />   <!-- 입력 -->
                    <RowDefinition Height="Auto" />   <!-- 안내 -->
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,4">
                    <TextBlock DockPanel.Dock="Left" Text="{loc:Loc ChatPanelTitle}"
                               Style="{StaticResource SubHeading}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Command="{Binding ToggleChatCommand}" Content="✕"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Padding="8,2" FontSize="13" Foreground="{StaticResource Muted}" />
                </DockPanel>

                <!-- 지금 어느 화면에서 무엇을 하던 중인지. 이것을 함께 넘기므로
                     "무엇을 하고 계셨나요"부터 다시 묻지 않습니다. -->
                <TextBlock Grid.Row="1" Text="{Binding ChatContextText}" Style="{StaticResource Micro}"
                           TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding ChatContextText, Converter={StaticResource NullToVisibility}}" />

                <!-- 첫 질문은 버튼 하나로. 빈 입력칸만 있으면 무엇을 물어야 할지 몰라 닫습니다. -->
                <StackPanel Grid.Row="2" Margin="0,0,0,10"
                            Visibility="{Binding HasChat, Converter={StaticResource InverseBoolToVisibility}}">
                    <Button Command="{Binding AskClaudeCommand}" Content="{loc:Loc AskButton}"
                            HorizontalAlignment="Stretch" Padding="14,9"
                            Style="{StaticResource AccentButton}" />
                    <TextBlock Text="{loc:Loc AskHint}" Style="{StaticResource Micro}"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource SurfaceAlt}" CornerRadius="6" Padding="10"
                        Visibility="{Binding HasChat, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Who}" FontWeight="SemiBold" FontSize="11.5"
                                                   Foreground="{StaticResource Muted}" Margin="0,0,0,3" />
                                        <!-- TextBox라 사용자가 답을 골라 복사할 수 있습니다. -->
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 TextWrapping="Wrap" FontSize="12.5" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="4" Text="{Binding AskProgress}" Style="{StaticResource Caption}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding AskProgress, Converter={StaticResource NullToVisibility}}" />

                <Grid Grid.Row="5" Margin="0,10,0,0"
                      Visibility="{Binding HasChat, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="False" Padding="8,7" FontSize="12.5">
                        <!-- 답을 기다리는 동안에는 잠급니다 — 두 질문이 같은 대화에 겹쳐 들어가면
                             순서가 엉킵니다. -->
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AskBusy}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendChatCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Command="{Binding SendChatCommand}" Content="{loc:Loc ChatSend}"
                            Padding="12,7" Margin="8,0,0,0" Style="{StaticResource AccentButton}"
                            Visibility="{Binding AskBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                    <Button Grid.Column="1" Command="{Binding CancelAskCommand}" Content="{loc:Loc AskCancel}"
                            Padding="12,7" Margin="8,0,0,0"
                            Visibility="{Binding AskBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Row="6" Margin="0,8,0,0">
                    <Button Command="{Binding NewChatCommand}" Content="{loc:Loc ChatNew}"
                            HorizontalAlignment="Left" Padding="12,5" FontSize="12"
                            Visibility="{Binding HasChat, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{loc:Loc AskDisclaimer}" Style="{StaticResource Micro}"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
