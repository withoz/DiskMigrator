<Window x:Class="DiskMigrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DiskMigrator.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="DiskMigrator — 디스크 클론" Height="840" Width="1180"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceAlt}"
        FontFamily="Segoe UI, Malgun Gothic">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 헤더 ===== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="DiskMigrator" Style="{StaticResource Heading}" />
                    <TextBlock Text="디스크 전체를 섹터 단위로 복제합니다 — 실행 중인 시스템 디스크 포함"
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#FEF2F2" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                        CornerRadius="4" Padding="10,5"
                        Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="관리자 권한 아님 — 클론을 실행할 수 없습니다"
                               Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <!-- ===== 1단계: 선택 ===== -->
        <Grid Grid.Row="1" Margin="24"
              Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Selecting}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 원본 -->
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="원본 (읽기)" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                        <Button Content="새로고침" Command="{Binding RefreshDisksCommand}"
                                Padding="8,3" MinWidth="0" FontSize="11" Margin="12,0,0,0" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedSource}"
                             Style="{StaticResource DiskListStyle}" />
                </DockPanel>

                <!-- 화살표 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="&#x2192;" FontSize="34" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" FontWeight="Bold" />
                    <TextBlock Text="복제" FontSize="11" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 대상 -->
                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="대상 (모든 데이터가 삭제됨)"
                               Style="{StaticResource SubHeading}" Foreground="{StaticResource Danger}"
                               Margin="0,0,0,8" />

                    <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedTarget}"
                             Style="{StaticResource DiskListStyle}" />
                </DockPanel>
            </Grid>

            <!-- 하단 패널 -->
            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
                <StackPanel>

                    <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource Danger}"
                               TextWrapping="Wrap" Margin="0,0,0,10"
                               Visibility="{Binding LoadError, Converter={StaticResource NullToVisibility}}" />

                    <!-- 옵션 -->
                    <WrapPanel Margin="0,0,0,12">
                        <CheckBox IsChecked="{Binding UseSnapshot}" IsEnabled="{Binding IsSnapshotAvailable}"
                                  VerticalContentAlignment="Center" Margin="0,0,20,4">
                            <TextBlock>
                                <Run Text="VSS 스냅샷 사용 (권장)" FontWeight="SemiBold" />
                                <Run Text=" — 복제 중 파일이 바뀌어도 일관된 사본을 만듭니다"
                                     Foreground="{StaticResource Muted}" FontSize="11" />
                            </TextBlock>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding VerifyAfterClone}" VerticalContentAlignment="Center"
                                  Margin="0,0,20,4">
                            <TextBlock>
                                <Run Text="복제 후 검증" FontWeight="SemiBold" />
                                <Run Text=" — 다시 읽어 원본과 비교합니다 (시간 약 2배)"
                                     Foreground="{StaticResource Muted}" FontSize="11" />
                            </TextBlock>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding ZeroFillBadSectors}" VerticalContentAlignment="Center"
                                  Margin="0,0,20,4">
                            <TextBlock>
                                <Run Text="불량 섹터 건너뛰기" FontWeight="SemiBold" />
                                <Run Text=" — 읽지 못한 섹터를 0으로 채우고 계속합니다"
                                     Foreground="{StaticResource Muted}" FontSize="11" />
                            </TextBlock>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding SkipUnusedBlocks}" IsEnabled="{Binding UseSnapshot}"
                                  VerticalContentAlignment="Center" Margin="0,0,20,4">
                            <TextBlock>
                                <Run Text="스마트 클론 (빈 영역 건너뛰기)" FontWeight="SemiBold" />
                                <Run Text=" — 사용 중인 블록만 복사해 빠르게 (스냅샷 필요)"
                                     Foreground="{StaticResource Muted}" FontSize="11" />
                            </TextBlock>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding ExpandLastPartition}"
                                  VerticalContentAlignment="Center" Margin="0,0,20,4">
                            <TextBlock>
                                <Run Text="마지막 파티션 확장" FontWeight="SemiBold" />
                                <Run Text=" — 큰 디스크로 복제 시 남는 공간을 마지막 파티션에 합침"
                                     Foreground="{StaticResource Muted}" FontSize="11" />
                            </TextBlock>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding UniversalRestore}" VerticalContentAlignment="Center"
                                  Margin="0,0,0,4">
                            <TextBlock>
                                <Run Text="새 하드웨어 대비 (Universal Restore)" FontWeight="SemiBold" />
                                <Run Text=" — 클론한 시스템을 다른 PC로 옮겨도 부팅되게 저장소 드라이버 활성화"
                                     Foreground="{StaticResource Muted}" FontSize="11" />
                            </TextBlock>
                        </CheckBox>
                    </WrapPanel>

                    <!-- 파티션 리사이즈 (확대) — 대상이 원본보다 클 때만 -->
                    <StackPanel Margin="0,0,0,12" IsEnabled="{Binding CanResize}">
                        <CheckBox IsChecked="{Binding ResizeEnabled}" VerticalContentAlignment="Center">
                            <TextBlock>
                                <Run Text="파티션 리사이즈 (확대)" FontWeight="SemiBold" />
                                <Run Text=" — 대상이 더 클 때 고른 파티션을 넓히고 뒤 파티션을 밀어냅니다"
                                     Foreground="{StaticResource Muted}" FontSize="11" />
                            </TextBlock>
                        </CheckBox>

                        <StackPanel Margin="24,8,0,0"
                                    Visibility="{Binding ResizeEnabled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="확대할 파티션:" VerticalAlignment="Center"
                                           Margin="0,0,8,0" FontSize="12" />
                                <ComboBox MinWidth="340" ItemsSource="{Binding ResizablePartitions}"
                                          SelectedItem="{Binding SelectedResizePartition}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ResizeFillRadio" GroupName="ResizeMode"
                                             IsChecked="{Binding ResizeFillRemaining}"
                                             Content="남는 공간 전부" VerticalContentAlignment="Center"
                                             Margin="0,0,16,0" FontSize="12" />
                                <RadioButton x:Name="ResizeSizeRadio" GroupName="ResizeMode"
                                             Content="지정 크기(GB):" VerticalContentAlignment="Center"
                                             Margin="0,0,6,0" FontSize="12" />
                                <TextBox Width="70" Text="{Binding ResizeSizeGb}" VerticalContentAlignment="Center"
                                         IsEnabled="{Binding IsChecked, ElementName=ResizeSizeRadio}" />
                            </StackPanel>

                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                       FontSize="11" Margin="0,6,0,0"
                                       Text="클론 중 자동 확장이 안 되면(원본이 함께 연결된 경우), 완료 화면의 '파티션 확장' 버튼으로 마무리하세요. NTFS 파티션만 확대할 수 있습니다." />
                        </StackPanel>
                    </StackPanel>

                    <!-- 안전 점검 결과 -->
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding SafetyIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="66" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="3" Padding="5,1"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                            <TextBlock Text="{Binding Severity, Converter={StaticResource SeverityToLabel}}"
                                                       Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                                                   FontSize="12" Margin="8,0,0,0"
                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 확인 입력 -->
                    <StackPanel Visibility="{Binding NeedsConfirmation, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,4,0,10">
                        <TextBlock Text="{Binding ConfirmationPrompt}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Danger}" FontSize="12" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ConfirmationText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6" FontSize="13" MaxWidth="440" HorizontalAlignment="Left"
                                 FontFamily="Consolas, D2Coding" />
                    </StackPanel>

                    <!-- 실행 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="이 작업은 되돌릴 수 없습니다. 대상 디스크를 다시 확인하십시오."
                                   Foreground="{StaticResource Muted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="클론 시작" Command="{Binding StartCommand}"
                                Style="{StaticResource DangerButton}" MinWidth="130" Padding="20,10" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 2단계: 진행 중 ===== -->
        <Grid Grid.Row="1" Margin="24"
              Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Running}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="8" Padding="40"
                    VerticalAlignment="Center" MaxWidth="720">
                <StackPanel>
                    <TextBlock Text="{Binding ProgressPhase}" Style="{StaticResource Heading}"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding ProgressRegion}" Foreground="{StaticResource Muted}"
                               FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,20"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock HorizontalAlignment="Center" FontSize="42" FontWeight="Light" Margin="0,0,0,8">
                        <Run Text="{Binding ProgressPercent, StringFormat={}{0:F1}, Mode=OneWay}" />
                        <Run Text="%" FontSize="24" Foreground="{StaticResource Muted}" />
                    </TextBlock>

                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="10"
                                 Foreground="{StaticResource Accent}" Background="#F3F4F6"
                                 BorderThickness="0" Margin="0,0,0,24" />

                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="복사됨" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressBytes}" FontSize="13" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="속도" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressSpeed}" FontSize="13" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="남은 시간" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressEta}" FontSize="13" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="경과" Style="{StaticResource SubHeading}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding ProgressElapsed}" FontSize="13" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"
                                MinWidth="110" Margin="0,0,10,0" />
                        <Button Content="취소" Command="{Binding CancelCommand}"
                                Style="{StaticResource DangerButton}" MinWidth="110" />
                    </StackPanel>

                    <TextBlock Text="작업 중에는 대상 디스크의 연결을 끊거나 PC를 끄지 마십시오."
                               Foreground="{StaticResource Muted}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== 3단계: 결과 ===== -->
        <Grid Grid.Row="1" Margin="24"
              Visibility="{Binding Stage, Converter={StaticResource StageToVisibility}, ConverterParameter=Finished}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1" CornerRadius="8" Padding="40"
                    VerticalAlignment="Center" MaxWidth="760">
                <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Heading}">
                                <Setter Property="FontSize" Value="22" />
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultIsSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" FontSize="13"
                               Margin="0,10,0,20" />

                    <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="6" Padding="16">
                        <TextBlock Text="{Binding ResultDetails}" TextWrapping="Wrap" FontSize="12"
                                   LineHeight="22" />
                    </Border>

                    <!-- 부팅 구성 검사 (성공 시) -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding ResultIsSuccess, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="부팅 구성 검사" Command="{Binding BootCheckCommand}"
                                    MinWidth="130" Padding="16,8" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="440"
                                       Text="실제 부팅 없이 부트로더·BCD·winload·저장소 드라이버 무결성을 점검합니다." />
                        </StackPanel>

                        <TextBlock Text="검사 중..." Margin="0,8,0,0" FontSize="12"
                                   Foreground="{StaticResource Muted}"
                                   Visibility="{Binding IsBootChecking, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 검사 결과 -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding BootCheckRan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BootCheckVerdict}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BootCheckVerdictIsGood}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding BootCheckItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="74" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" CornerRadius="3" Padding="5,1"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            Background="{Binding StatusBrush}">
                                                        <TextBlock Text="{Binding Mark}" Foreground="White"
                                                                   FontSize="10" FontWeight="SemiBold" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                                                   Foreground="{StaticResource Muted}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- 부팅 복구 (BCD 장치 참조 문제 시) -->
                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding BootRepairAvailable, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="부팅 복구" Command="{Binding RepairBootCommand}"
                                            MinWidth="120" Padding="14,7" />
                                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="420"
                                               Text="BCD 장치 참조를 이 디스크의 파티션으로 다시 설정해 0xc000000e를 고칩니다." />
                                </StackPanel>
                                <TextBlock Text="복구 중..." Margin="0,6,0,0" FontSize="12"
                                           Foreground="{StaticResource Muted}"
                                           Visibility="{Binding IsRepairingBoot, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <TextBlock Text="{Binding BootRepairMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                                       Visibility="{Binding BootRepairRan, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BootRepairSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- 파티션 확장 (대상에 남는 공간이 있을 때) -->
                    <StackPanel Margin="0,20,0,0"
                                Visibility="{Binding PartitionExpandAvailable, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="파티션 확장" Command="{Binding ExpandPartitionCommand}"
                                    MinWidth="130" Padding="16,8" />
                            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="440"
                                       Text="확대한 파티션(리사이즈) 또는 마지막 파티션을 남는 미할당 공간까지 넓힙니다. 대상을 단독으로 연결한 상태(원본 분리)에서 가장 확실하게 동작합니다." />
                        </StackPanel>

                        <TextBlock Text="확장 중..." Margin="0,6,0,0" FontSize="12"
                                   Foreground="{StaticResource Muted}"
                                   Visibility="{Binding IsExpandingPartition, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding PartitionExpandMessage}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                               Visibility="{Binding PartitionExpandRan, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PartitionExpandSuccess}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Content="처음으로" Command="{Binding BackToSelectionCommand}"
                            Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                            Margin="0,20,0,0" MinWidth="120" Padding="20,10" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
