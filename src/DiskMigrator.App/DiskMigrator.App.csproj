<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DiskMigrator.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>

    <!--
      exe 속성·작업표시줄·설치 프로그램이 읽는 제품 정보. 회사/제품명은 상표·서명 인증서와
      같아야 하므로 배포 주체가 정해지면 맞춰 바꾸십시오(지금은 제품명을 그대로 씁니다).
    -->
    <Product>DiskMigrator</Product>
    <AssemblyTitle>DiskMigrator</AssemblyTitle>
    <Company>DiskMigrator</Company>
    <Authors>DiskMigrator</Authors>
    <Description>Windows 시스템 디스크를 통째로 복제해 다른 PC로 옮기는 도구</Description>
    <Copyright>Copyright © 2026 DiskMigrator</Copyright>

    <!-- 마케팅 버전. 릴리스 태그(v0.7.0)와 맞춥니다. -->
    <Version>0.7.0</Version>
    <FileVersion>0.7.0.0</FileVersion>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <!-- 제품 버전에 git 커밋 해시가 붙지 않도록. 파일 속성에 "0.7.0"만 보입니다. -->
    <InformationalVersion>0.7.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- GitHub Releases 배포용: 런타임 미설치 PC에서도 실행되는 단일 exe -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!--
      AlphaVSS.x64.dll은 혼합 모드(C++/CLI) 어셈블리라 단일 exe 안에서 메모리로 로드할 수
      없고, 반드시 디스크에 풀린 상태여야 합니다. 게다가 AlphaVSS의 자체 어셈블리 리졸버는
      실행 폴더에서 "AlphaVSS.x64.dll"과 "Ijwhost.dll"을 파일로 찾습니다.

      IncludeNativeLibrariesForSelfExtract 만으로는 이 혼합 어셈블리가 리졸버가 찾는 위치에
      풀리지 않아, 실기에서 "Failed to find assembly AlphaVSS.x64" 오류로 VSS가 로드되지
      않았습니다. 그 결과 스냅샷 없이 라이브 시스템 디스크가 복제되어 불일치가 생겼습니다.

      IncludeAllContentForSelfExtract=true 로 바꾸면 모든 콘텐츠(관리·네이티브·혼합)를
      시작 시 임시 폴더로 풀고 그 폴더에서 실행하므로, 일반 폴더 배포와 동일한 레이아웃이
      되어 AlphaVSS 리졸버가 파일을 찾습니다. 첫 실행이 몇 초 느려지는 대신 확실합니다.
    -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- 혼합 모드 어셈블리는 압축 시 추출 로드가 불안정할 수 있어 압축을 끕니다. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- AlphaVSS는 런타임에 OS 버전별 네이티브 인터롭 어셈블리를 리플렉션으로 로드하므로 트리밍 금지 -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiskMigrator.Core\DiskMigrator.Core.csproj" />
    <ProjectReference Include="..\DiskMigrator.Windows\DiskMigrator.Windows.csproj" />
  </ItemGroup>

  <!-- 최초 실행 EULA 동의 화면이 읽는 사용권 계약 본문(한/영). exe에 내장합니다.
       Strings.resx / Strings.en.resx 는 SDK가 자동으로 포함·위성 어셈블리로 만듭니다. -->
  <!-- 시작 화면: 앱이 로드되는 동안 다크 로고를 즉시 띄웁니다(WPF 기본 스플래시). -->
  <ItemGroup>
    <SplashScreen Include="Resources\splash.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\EULA.txt" />
    <!-- 파일명의 ".en."을 MSBuild가 위성(언어) 리소스로 오인하지 않게 WithCulture=false로
         고정하고, 코드가 찾는 이름과 맞도록 LogicalName을 명시합니다. -->
    <EmbeddedResource Include="Resources\EULA.en.txt">
      <WithCulture>false</WithCulture>
      <LogicalName>DiskMigrator.App.Resources.EULA.en.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
