<Application x:Class="DiskMigrator.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DiskMigrator.App.Converters"
             xmlns:rt="clr-namespace:DiskMigrator.App.Runtime">
    <Application.Resources>
        <ResourceDictionary>

            <!--
                팔레트는 Themes\Light.xaml · Dark.xaml 두 벌로 나뉘어 있고, 시작할 때 한쪽을
                끼웁니다(App.ApplyTheme). 여기 아래의 스타일들은 색을 <b>DynamicResource</b>로
                참조합니다 — StaticResource로 두면 App.xaml을 읽는 순간 값이 굳어, 나중에
                팔레트를 갈아 끼워도 스타일은 옛 색을 그대로 쥐고 있습니다.

                화면(MainWindow.xaml)은 StaticResource 그대로 둡니다. 모드를 바꿀 때 창을
                새로 그리므로(언어 전환과 같은 길) 그 시점의 팔레트로 읽힙니다.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:StageToVisibilityConverter x:Key="StageToVisibility" />
        <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <conv:SeverityToLabelConverter x:Key="SeverityToLabel" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:FractionToWidthConverter x:Key="FractionToWidth" />
        <conv:AllTrueToVisibilityConverter x:Key="AllTrueToVisibility" />

        <!--
            타입 스케일 — 이름으로만 쓰고 화면에서 숫자를 직접 적지 않습니다.
            예전에는 10·11·12·13이 3px 안에 몰려 있어 크기 차이가 위계로 읽히지 않았습니다.
        -->
        <FontFamily x:Key="UiFont">Segoe UI, Malgun Gothic</FontFamily>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- 앱 제목 -->
        <Style x:Key="Display" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- 단계·결과 제목 -->
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- 디스크 모델명 등 -->
        <Style x:Key="Subtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- 본문·옵션 라벨 -->
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <!-- 보조 설명·범례 -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- 배지·메타(S/N, 버스 종류) -->
        <Style x:Key="Micro" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- 섹션 라벨 (원본/대상, 안전/동작) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- 이전 이름 유지 (아직 참조하는 곳이 있어 남겨 둡니다) -->
        <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource Display}" />
        <Style x:Key="SubHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}" />

        <!--
            단계 표식 — 선택 → 옵션 → 확인·실행은 실제로 순서가 있는 절차라서 번호를 씁니다.
            장식이 아니라 "어디까지 왔는지"를 알려주는 정보입니다.
        -->
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>

        <Style x:Key="StepNumberText" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <!-- ⚠ TextElement.Foreground가 없으면 버튼의 Foreground가 글자에
                                 닿지 않습니다. 글 내용은 ContentPresenter가 TextBlock으로 만드는데,
                                 그 TextBlock이 앱의 암시적 TextBlock 스타일(TextBrush)을 먼저
                                 집어가기 때문입니다 — 버튼 색을 아무리 바꿔도 글자는 그대로였습니다.
                                 AccentButton에는 이 줄이 있었고 여기만 빠져 있었습니다. -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 디스크 목록 항목: 어떤 디스크인지 한눈에 알아보지 못하면 사용자가 잘못 고릅니다. -->
        <DataTemplate x:Key="DiskItemTemplate">
            <Border Padding="10,8" Background="Transparent">
                <StackPanel>
                    <!--
                        배지를 이름·용량과 같은 줄에 둡니다. 따로 줄을 차지하면 항목마다 한 줄이
                        늘어나 목록에 보이는 디스크 수가 줄어듭니다 — 이 화면에서 가장 중요한 게
                        목록이므로 세로 공간을 아낍니다.
                        지우면 곤란한 디스크는 빨강, 단순 사실은 파랑으로 성격을 가릅니다.
                    -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Model}" Style="{StaticResource Subtitle}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="260"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SizeText}" Margin="8,0,0,0"
                                   Style="{StaticResource Subtitle}"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />

                        <Border Background="{DynamicResource DangerSoft}" BorderBrush="{DynamicResource Danger}"
                                BorderThickness="1" CornerRadius="3" Padding="5,0" Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasWarningBadges, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding WarningBadgeText}" Style="{StaticResource Micro}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Danger}" />
                        </Border>

                        <Border BorderBrush="{DynamicResource Info}" BorderThickness="1"
                                CornerRadius="3" Padding="5,0" Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasInfoBadges, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding InfoBadgeText}" Style="{StaticResource Micro}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Info}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Micro}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                    <!--
                        드라이브 문자를 요약 앞 고정 칸으로 뺍니다. 요약 안에 섞으면 앞에
                        EFI·MSR이 있는 디스크는 문자가 줄 한가운데로 밀려 항목마다 위치가
                        달라집니다 — 눈이 훑을 기준선이 사라져 알아보기 어렵습니다.
                        문자가 없는 디스크도 칸은 비워 두어 아래 줄이 어긋나지 않게 합니다.
                    -->
                    <DockPanel Margin="0,3,0,0" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding DriveLetterText}"
                                   Style="{StaticResource Caption}" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"
                                   MinWidth="24" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding PartitionSummary}" Style="{StaticResource Caption}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--
            목록 항목 — 기본 ListBoxItem은 윈도우 시스템 강조색(파랑)으로 칠해져 이 화면의
            따뜻한 색조와 따로 놉니다. 골라 둔 디스크가 무엇인지가 이 도구에서 가장 중요한
            정보이므로 직접 그립니다. 항목 사이 가는 선으로 어디까지가 한 디스크인지 가르고,
            고른 항목은 왼쪽 강조색 띠로 표시합니다 — 배경색만으로는 흐린 화면에서 놓칩니다.
        -->
        <!--
            칩 라디오 — 동그라미 대신 눌린 상태를 배경·테두리로 보여 줍니다.
            고를 것이 보통 한둘이라 드롭다운보다 펼쳐 두는 편이 빠릅니다.
        -->
        <Style x:Key="ChipRadio" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="5" BorderThickness="1"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Label" VerticalAlignment="Center"
                                              TextElement.FontSize="12"
                                              TextElement.Foreground="{DynamicResource TextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{DynamicResource SelectionSoft}" />
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{DynamicResource Accent}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground"
                                        Value="{DynamicResource Accent}" />
                                <Setter TargetName="Label" Property="TextElement.FontWeight"
                                        Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiskListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Marker" Grid.Column="0" Background="Transparent" />
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource DangerSoft}" />
                                <Setter TargetName="Marker" Property="Background"
                                        Value="{DynamicResource Danger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiskListStyle" TargetType="ListBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="ItemTemplate" Value="{StaticResource DiskItemTemplate}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DiskListItemStyle}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />

            <!--
                원본·대상 목록이 같은 Disks 컬렉션을 씁니다. WPF는 컬렉션마다 기본
                CollectionView를 하나만 만들어 공유하는데, 이 값이 기본(null)이면 선택이
                그 CurrentItem을 따라가므로 한쪽에서 고른 디스크가 다른 쪽에서도 선택됩니다.
                디스크를 지우는 도구에서 원본과 대상이 저절로 같아지는 건 위험합니다.
            -->
            <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />

            <!--
                Claude의 제안을 [적용]하면 코드가 선택을 바꿉니다. WPF는 그때 목록을 움직이지
                않으므로, 디스크가 여러 개면 선택된 항목이 화면 밖에 남아 아무것도 선택되지
                않은 것처럼 보입니다. 무엇에 동의했는지 눈으로 확인할 수 없으면 카드의 뜻이 없습니다.
            -->
            <Setter Property="rt:SelectionVisibility.AutoScroll" Value="True" />
        </Style>

        <!--
            ===== Windows 기본 부품을 팔레트 안으로 =====

            체크상자·입력란·스크롤 막대·펼침·진행 막대는 Windows가 자기 색으로 그립니다.
            그대로 두면 어두운 화면에 <b>흰 조각으로 남습니다</b> — 실기에서 그렇게 나왔습니다.
            반만 어두운 화면은 안 하느니만 못하므로 이 다섯을 직접 그립니다.

            생김새는 밝은 쪽 기준으로 지금과 같게 두었습니다. 색조를 넣는 작업이지
            모양을 바꾸는 작업이 아닙니다.
        -->

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                    BorderThickness="1" VerticalAlignment="Center" Margin="0,0,7,0"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderBrushSoft}">
                                <Path x:Name="Tick" Visibility="Collapsed"
                                      Data="M 0,3.5 L 2.7,6.2 L 7.5,1"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 입력란 — 모델명을 <b>직접 옮겨 적는</b> 자리가 여기입니다. 글자가 안 보이면
             확인 절차 자체가 막히므로 글자색·커서색을 모두 팔레트에서 잡습니다. -->
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 스크롤 막대 — 화살표 단추를 없애고 손잡이만 남깁니다. 목록 옆에 늘 붙어 있는
             부품이라 밝은 채로 두면 어두운 화면에서 가장 먼저 눈에 띕니다. -->
        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="4"
                                Margin="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                </Track.Thumb>
                                <!-- 화살표 단추 자리. RepeatButton이 없으면 Track이 만들어지지
                                     않으므로 보이지 않는 것으로 채웁니다. -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                  Background="Transparent" BorderThickness="0" MinWidth="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                  Background="Transparent" BorderThickness="0" MinWidth="0" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="11" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource NeutralSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                ClipToBounds="True">
                            <Grid>
                                <Rectangle x:Name="PART_Track" />
                                <Rectangle x:Name="PART_Indicator" HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}" RadiusX="5" RadiusY="5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 펼침(진단 저장 등) — 머리글 글자와 화살표가 기본 검정이라 어두운 화면에서 사라집니다. -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="Head" Cursor="Hand"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <StackPanel Orientation="Horizontal" Background="Transparent">
                                            <Path x:Name="Arrow" Width="9" Height="9" Margin="0,0,7,0"
                                                  VerticalAlignment="Center"
                                                  Data="M 0,0 L 4,4 L 0,8"
                                                  Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                                                  StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                                            <ContentPresenter VerticalAlignment="Center"
                                                              TextElement.Foreground="{DynamicResource Muted}"
                                                              TextElement.FontSize="12" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" CenterX="2" CenterY="4" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="0,8,0,0" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
